<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">..\..\icon\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>

    <Product>Ferry</Product>
    <!-- Version は Directory.Build.props で単一管理 (ここで再定義すると props を上書きして同期漏れの元) -->
    <Description>P2P File Transfer Application</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>link</TrimMode>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Styles\**" />
    <AvaloniaResource Include="Resources\**" />
    <AvaloniaResource Include="..\..\icon\app.ico" Link="icon\app.ico" />
  </ItemGroup>

  <Target Name="GenerateIcon" BeforeTargets="BeforeBuild" Inputs="..\..\icon\app_icon.png" Outputs="..\..\icon\app.ico" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="powershell -ExecutionPolicy Bypass -NoProfile -File &quot;$(ProjectDir)..\..\icon\generate_icon.ps1&quot;" />
  </Target>

  <!-- AppVersion.Value を Directory.Build.props の <Version> から毎ビルド生成する。
       手書き定数だと /vava のたびに同期漏れが起き、実際に 1.0.65 のまま 3 リリース放置された
       (About 表示・presence のバージョン分布・IgnoreUpdateTag の陳腐化判定が全部ズレる)。
       Native AOT でリフレクションに頼れないので、compile-time 定数であることは維持したまま
       「単一の正本から生成する」形にしてドリフトを構造的に潰す。 -->
  <Target Name="GenerateAppVersion" BeforeTargets="BeforeCompile;CoreCompile">
    <!-- IntermediateOutputPath は .targets 評価後にしか確定しないので、必ず Target 内で解決する。 -->
    <PropertyGroup>
      <AppVersionGeneratedPath>$(IntermediateOutputPath)AppVersion.g.cs</AppVersionGeneratedPath>
    </PropertyGroup>
    <ItemGroup>
      <AppVersionLines Include="// 自動生成ファイル: Ferry.csproj の GenerateAppVersion が Directory.Build.props の Version から生成する。手で編集しない。" />
      <AppVersionLines Include="namespace Ferry%3B" />
      <AppVersionLines Include="// アプリケーションバージョンの compile-time 定数。正本は Directory.Build.props の Version。" />
      <AppVersionLines Include="internal static class AppVersion" />
      <AppVersionLines Include="{" />
      <AppVersionLines Include="    public const string Value = &quot;$(Version)&quot;%3B" />
      <AppVersionLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(AppVersionGeneratedPath)" Lines="@(AppVersionLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(AppVersionGeneratedPath)" />
      <FileWrites Include="$(AppVersionGeneratedPath)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <!-- デベロッパーツール。旧 Avalonia.Diagnostics は非推奨 (かつ 11 系止まりで本体 12 系と不揃い)
         だったため AvaloniaUI.DiagnosticsSupport へ移行した。UI は別プロセスの
         グローバルツール AvaloniaUI.DeveloperTools が提供する
         (導入は dotnet tool install で global 指定)。
         Debug 限定なので Release / Native AOT 発行には含まれない
         (Program.cs の WithDeveloperTools も #if DEBUG。アタッチはそこ 1 箇所だけ行う)。 -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Komorebi と同じローカライズ＆アイコン注入パターンで自動更新ダイアログを提供する。
         自前の SelfUpdateWindow/VM/Model は撤去し、このライブラリの UpdateDialogWindow に統一 -->
    <PackageReference Include="VelopackUpdateDialog.Avalonia" Version="1.0.10" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="SuperLightLogger" Version="1.0.9" />
    <!-- Avalonia の Linux サポートが Tmds.DBus.Protocol を transitive に引くため、
         CVE 対応版 (0.93.0) を直接指定して上書きする。-->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Ferry" />
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
    <TrimmerRootAssembly Include="Avalonia.Desktop" />
    <TrimmerRootAssembly Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <!-- UDP ホールパンチの確立状態遷移など内部実装の回帰テストのため Ferry.Tests に internal を公開 -->
    <InternalsVisibleTo Include="Ferry.Tests" />
  </ItemGroup>
</Project>
