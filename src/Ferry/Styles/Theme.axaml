<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- === Avalonia FluentTheme アクセントカラー上書き === -->
        <Color x:Key="SystemAccentColor">#007AFF</Color>
        <Color x:Key="SystemAccentColorDark1">#0A84FF</Color>
        <Color x:Key="SystemAccentColorDark2">#409CFF</Color>
        <Color x:Key="SystemAccentColorDark3">#66B3FF</Color>
        <Color x:Key="SystemAccentColorLight1">#0064D2</Color>
        <Color x:Key="SystemAccentColorLight2">#004DA6</Color>
        <Color x:Key="SystemAccentColorLight3">#003580</Color>

        <!-- === ダークテーマ色（デフォルト） === -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#161618" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#222224" />
        <SolidColorBrush x:Key="GlassBrush" Color="#2A2A2E" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2A2A2C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#007AFF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#0A84FF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F7" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E8E93" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#636366" />
        <SolidColorBrush x:Key="GreenBrush" Color="#30D158" />
        <SolidColorBrush x:Key="RedBrush" Color="#FF453A" />
        <SolidColorBrush x:Key="YellowBrush" Color="#FFD60A" />
        <SolidColorBrush x:Key="BorderBrush" Color="#38383A" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#1C1C1E" />
        <SolidColorBrush x:Key="OverlayBrush" Color="#80000000" />
        <SolidColorBrush x:Key="BadgeBrush" Color="#FF453A" />
        <SolidColorBrush x:Key="PeerSelectedBrush" Color="#1A3A5C" />
        <SolidColorBrush x:Key="OfflineBrush" Color="#FF453A" />

        <!-- Tahoe ダイアログ用ブラシ（AddMemberWindow, SelfUpdateWindow 等） -->
        <SolidColorBrush x:Key="TahoeWindowBgBrush" Color="#161618" />
        <SolidColorBrush x:Key="TahoeTextPrimaryBrush" Color="#F5F5F7" />
        <SolidColorBrush x:Key="TahoeTextSecondaryBrush" Color="#8E8E93" />
        <SolidColorBrush x:Key="TahoeTextTertiaryBrush" Color="#636366" />

        <!-- === 共通サイズ === -->
        <x:Double x:Key="SidebarWidth">220</x:Double>
        <x:Double x:Key="TitleBarHeight">36</x:Double>
        <CornerRadius x:Key="SmallCornerRadius">4</CornerRadius>
        <CornerRadius x:Key="MediumCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="LargeCornerRadius">16</CornerRadius>
        <CornerRadius x:Key="BubbleCornerRadius">16</CornerRadius>
        <Thickness x:Key="BubblePadding">12,8</Thickness>
    </Styles.Resources>

    <!-- === Button スタイル === -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>

    <Style Selector="Button.sidebar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.sidebar:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource RedBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- === TextBox スタイル === -->
    <Style Selector="TextBox.search">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- === ListBox スタイル === -->
    <Style Selector="ListBox.peerList">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.peerList ListBoxItem">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.peerList ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PeerSelectedBrush}" />
    </Style>
    <Style Selector="ListBox.peerList ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>

    <Style Selector="ListBox.messageList">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.messageList ListBoxItem">
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style Selector="ListBox.messageList ListBoxItem /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.messageList ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.messageList ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- === ToggleSwitch スタイル === -->
    <Style Selector="ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
    </Style>

    <!-- === セクションヘッダー === -->
    <Style Selector="TextBlock.sectionHeader">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

    <Style Selector="TextBlock.settingLabel">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.settingDescription">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- === Tahoe ダイアログ用スタイル === -->
    <Style Selector="Border.glass-inner">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.tahoe-primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.tahoe-primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>

    <!-- === 未読バッジ === -->
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</Styles>
