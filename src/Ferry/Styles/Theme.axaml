<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ================================================================================
    Ferry — ROG NEON GAMING THEME (v1.0.38)
    水色 (cyan) × ピンク (magenta) のネオン融合。ASUS ROG / サイバーパンク風
    暗黒宇宙背景 + Cyan→Pink 斜めグラデアクセント + ネオングロー
    リソースキー名は既存と互換維持 (View 側 DynamicResource を壊さない)
    ================================================================================
    -->

    <Styles.Resources>
        <ResourceDictionary>
            <!-- ============================================================
                 THEME-VARIANT DICTIONARIES — テーマ依存 (背景 / サーフェス /
                 テキスト / ボーダー) は Light / Dark で切り替える。
                 DynamicResource で参照したものが ActualThemeVariant に応じて解決される。
                 ============================================================ -->
            <ResourceDictionary.ThemeDictionaries>

                <!-- ===== DARK — ROG ネオン (暗黒宇宙テーマ。既存色を踏襲) ===== -->
                <ResourceDictionary x:Key="Dark">
                    <!-- BACKGROUND & SURFACE — ROG はほぼ黒の宇宙 -->
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#04060E" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#0D1424" />
                    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="#101A33" />
                    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1A2849" />
                    <SolidColorBrush x:Key="GlassBrush" Color="#CC0D1424" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#06091A" />
                    <SolidColorBrush x:Key="OverlayBrush" Color="#CC020410" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#08101F" />
                    <!-- ウィンドウ全体のアクリル背景ティント (MainWindow.axaml が参照) -->
                    <Color x:Key="AcrylicTintColor">#04060E</Color>
                    <!-- TEXT — Cyan-tinted で技術感 -->
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8F8FF" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7AA0C8" />
                    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#4A6485" />
                    <SolidColorBrush x:Key="SectionHeaderBrush" Color="#00F0FF" />
                    <!-- BORDERS / SELECTION -->
                    <SolidColorBrush x:Key="BorderBrush" Color="#1F3A5A" />
                    <SolidColorBrush x:Key="PeerSelectedBrush" Color="#2500F0FF" />
                    <SolidColorBrush x:Key="OfflineBrush" Color="#4A5B78" />
                    <!-- Tahoe ダイアログ用 (キー名互換) -->
                    <SolidColorBrush x:Key="TahoeWindowBgBrush" Color="#04060E" />
                    <SolidColorBrush x:Key="TahoeTextPrimaryBrush" Color="#E8F8FF" />
                    <SolidColorBrush x:Key="TahoeTextSecondaryBrush" Color="#7AA0C8" />
                    <SolidColorBrush x:Key="TahoeTextTertiaryBrush" Color="#4A6485" />
                </ResourceDictionary>

                <!-- ===== LIGHT — ROG ネオン Light (明るい背景 + 暗いテキスト) =====
                     背景/サーフェスは白〜淡青、テキストは濃紺。
                     アクセント (ピンク/シアン) は共通リソース側で彩度高く維持。 -->
                <ResourceDictionary x:Key="Light">
                    <!-- BACKGROUND & SURFACE -->
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6FB" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="#EEF1F8" />
                    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E2E8F4" />
                    <SolidColorBrush x:Key="GlassBrush" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#E9EDF6" />
                    <SolidColorBrush x:Key="OverlayBrush" Color="#55000814" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
                    <!-- ウィンドウ全体のアクリル背景ティント (MainWindow.axaml が参照) -->
                    <Color x:Key="AcrylicTintColor">#EEF2F9</Color>
                    <!-- TEXT -->
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0A1424" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#566B88" />
                    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A9AB4" />
                    <SolidColorBrush x:Key="SectionHeaderBrush" Color="#C81866" />
                    <!-- BORDERS / SELECTION -->
                    <SolidColorBrush x:Key="BorderBrush" Color="#C8D2E2" />
                    <SolidColorBrush x:Key="PeerSelectedBrush" Color="#2200B8D4" />
                    <SolidColorBrush x:Key="OfflineBrush" Color="#94A2B8" />
                    <!-- Tahoe ダイアログ用 (キー名互換) -->
                    <SolidColorBrush x:Key="TahoeWindowBgBrush" Color="#F4F6FB" />
                    <SolidColorBrush x:Key="TahoeTextPrimaryBrush" Color="#0A1424" />
                    <SolidColorBrush x:Key="TahoeTextSecondaryBrush" Color="#566B88" />
                    <SolidColorBrush x:Key="TahoeTextTertiaryBrush" Color="#8A9AB4" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <!-- ============================================================
                 THEME-INDEPENDENT — ネオンアクセント / ステータス / サイズは
                 彩度が高く Light/Dark 双方で視認できるため共通化する。
                 ============================================================ -->
            <!-- RAW NEON PALETTE (この 5 色を組み合わせて全体を構成) -->
            <Color x:Key="NeonCyan">#00F0FF</Color>
            <Color x:Key="NeonCyanDeep">#0099CC</Color>
            <Color x:Key="NeonPink">#FF2D8A</Color>
            <Color x:Key="NeonPinkDeep">#CC1F6E</Color>
            <Color x:Key="NeonPurple">#B14AFF</Color>
            <Color x:Key="VoidBlack">#04060E</Color>
            <Color x:Key="DeepSpace">#0A1124</Color>
            <Color x:Key="SteelBlue">#7AA0C8</Color>

            <!-- === Avalonia FluentTheme アクセントカラー上書き (ピンク主体) ===
                 デフォルト Button (Classes="accent" 含む) と ToggleSwitch ON 色は
                 ここを引くので、ピンクに統一して読みづらい cyan ボタン問題を解消 -->
            <Color x:Key="SystemAccentColor">#FF2D8A</Color>
            <Color x:Key="SystemAccentColorDark1">#FF5BA5</Color>
            <Color x:Key="SystemAccentColorDark2">#FF8BC0</Color>
            <Color x:Key="SystemAccentColorDark3">#FFBDDB</Color>
            <Color x:Key="SystemAccentColorLight1">#E81E7A</Color>
            <Color x:Key="SystemAccentColorLight2">#C81866</Color>
            <Color x:Key="SystemAccentColorLight3">#A81356</Color>

            <!-- === ACCENT — ピンク主体グラデ (cyan は border/glow に降格) ===
                 理由: cyan→pink バランス型だと中央が紫味で文字読みづらかった
                 ROG らしい「赤ピンクが主役、cyan は冷たい光」のメリハリに変更 -->
            <LinearGradientBrush x:Key="AccentBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#FF2D8A" Offset="0.0" />
                <GradientStop Color="#E81E7A" Offset="0.5" />
                <GradientStop Color="#C81866" Offset="1.0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#FF5BA5" Offset="0.0" />
                <GradientStop Color="#FF2D8A" Offset="0.5" />
                <GradientStop Color="#E81E7A" Offset="1.0" />
            </LinearGradientBrush>
            <!-- アクセント単色版 (グラデ使えない場面のフォールバック) -->
            <SolidColorBrush x:Key="AccentSolidBrush" Color="#FF2D8A" />
            <SolidColorBrush x:Key="AccentPinkBrush" Color="#FF2D8A" />
            <SolidColorBrush x:Key="AccentCyanBrush" Color="#00F0FF" />

            <!-- === STATUS COLORS — 全てネオン化 === -->
            <SolidColorBrush x:Key="GreenBrush" Color="#00FF9D" />  <!-- ネオングリーン -->
            <SolidColorBrush x:Key="RedBrush" Color="#FF2D6A" />    <!-- ネオンレッド -->
            <SolidColorBrush x:Key="YellowBrush" Color="#FFE600" /> <!-- ネオンイエロー -->
            <SolidColorBrush x:Key="BlueBrush" Color="#00F0FF" />   <!-- ネオンシアン (P2P) -->
            <SolidColorBrush x:Key="OrangeBrush" Color="#FF8800" /> <!-- ネオンオレンジ -->

            <!-- === ROUTE BADGE SOFT TINTS — グロー強めで存在感↑ === -->
            <SolidColorBrush x:Key="GreenBrushSoft" Color="#3500FF9D" />
            <SolidColorBrush x:Key="GreenBrushBorder" Color="#AA00FF9D" />
            <SolidColorBrush x:Key="BlueBrushSoft" Color="#3500F0FF" />
            <SolidColorBrush x:Key="BlueBrushBorder" Color="#AA00F0FF" />
            <SolidColorBrush x:Key="OrangeBrushSoft" Color="#35FF8800" />
            <SolidColorBrush x:Key="OrangeBrushBorder" Color="#AAFF8800" />

            <!-- === BORDERS (glow) / BADGE === -->
            <SolidColorBrush x:Key="BorderGlowBrush" Color="#5500F0FF" />
            <SolidColorBrush x:Key="BadgeBrush" Color="#FF2D8A" />   <!-- 未読バッジはピンク -->

            <!-- === SIZES — ROG はやや角ばらせる (CornerRadius を引き締め) === -->
            <x:Double x:Key="SidebarWidth">220</x:Double>
            <x:Double x:Key="TitleBarHeight">36</x:Double>
            <CornerRadius x:Key="SmallCornerRadius">2</CornerRadius>
            <CornerRadius x:Key="MediumCornerRadius">4</CornerRadius>
            <CornerRadius x:Key="LargeCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="BubbleCornerRadius">10</CornerRadius>
            <Thickness x:Key="BubblePadding">12,8</Thickness>
        </ResourceDictionary>
    </Styles.Resources>

    <!--
    ================================================================================
    BUTTON STYLES — v1.0.48: ピンク主体に統一 + CornerRadius 6 で統一
    ================================================================================
    全ボタン (class なしのデフォルト Button も含む) を AccentBrush (ピンク) + CornerRadius=6 に揃える。
    icon / sidebar / sidebarMenuItem の「絵文字・メニュー用」用途は透過を維持しつつ角丸だけ 6 に。
    danger は意味的区別 (赤=危険) を残すため、角丸 6 のみ揃えて色は維持する。
    -->

    <!-- === デフォルト Button (class 指定なし) — accent と同等のピンクスタイル ===
         「変更」「キャンセル」「OK」のような汎用ボタンはこちらでピンクに統一される。
         Avalonia FluentTheme の Button デフォルトの灰色を打ち消す。 -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderBrush" Value="#88FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <DropShadowEffect Color="#FF2D8A" BlurRadius="12" Opacity="0.55" OffsetX="0" OffsetY="0" />
        </Setter>
    </Style>
    <Style Selector="Button /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#88FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button:pointerover">
        <Setter Property="BorderBrush" Value="#FFFFFF" />
        <Setter Property="Effect">
            <DropShadowEffect Color="#FF2D8A" BlurRadius="20" Opacity="0.8" OffsetX="0" OffsetY="0" />
        </Setter>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- === Accent (上記デフォルトと同等、後方互換のため明示的に保持) === -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LetterSpacing" Value="0.5" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderBrush" Value="#88FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <DropShadowEffect Color="#FF2D8A" BlurRadius="14" Opacity="0.7" OffsetX="0" OffsetY="0" />
        </Setter>
    </Style>
    <Style Selector="Button.accent /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#88FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.accent:pointerover">
        <Setter Property="BorderBrush" Value="#FFFFFF" />
        <Setter Property="Effect">
            <DropShadowEffect Color="#FF2D8A" BlurRadius="22" Opacity="0.9" OffsetX="0" OffsetY="0" />
        </Setter>
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- === Icon (絵文字ボタン用 - 小型、透過維持。CornerRadius のみ 6 に統一) ===
         デフォルト Button のピンク背景・ボーダー・グローを明示的に打ち消し、絵文字が映える小型ボタンに戻す。 -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.icon /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.icon:pointerover">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Effect">
            <DropShadowEffect Color="#FF2D8A" BlurRadius="14" Opacity="0.7" OffsetX="0" OffsetY="0" />
        </Setter>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#33FF2D8A" />
    </Style>

    <!-- === Sidebar (左寄せ汎用) — 透過維持、CornerRadius 6 統一 === -->
    <Style Selector="Button.sidebar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.sidebar /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.sidebar:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.sidebar:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#22FF2D8A" />
    </Style>

    <!-- === Danger (ネオンレッド) — 意味的区別のため赤を維持、CornerRadius 6 統一 === -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource RedBrush}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderBrush" Value="#55FF2D6A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.danger /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#55FF2D6A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.danger:pointerover">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Effect">
            <DropShadowEffect Color="#FF2D6A" BlurRadius="14" Opacity="0.85" OffsetX="0" OffsetY="0" />
        </Setter>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#33FF2D6A" />
    </Style>

    <!--
    ================================================================================
    TEXTBOX STYLES
    ================================================================================
    -->
    <Style Selector="TextBox.search">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="#00F0FF" />
        <Setter Property="SelectionBrush" Value="#5500F0FF" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Segoe UI" />
    </Style>
    <Style Selector="TextBox.search:focus">
        <Setter Property="BorderBrush" Value="#00F0FF" />
        <Setter Property="Effect">
            <DropShadowEffect Color="#00F0FF" BlurRadius="14" Opacity="0.55" OffsetX="0" OffsetY="0" />
        </Setter>
    </Style>

    <!-- Avalonia FluentTheme の TextBox デフォルト枠をテーマと揃える (汎用) -->
    <Style Selector="TextBox">
        <Setter Property="CaretBrush" Value="#00F0FF" />
        <Setter Property="SelectionBrush" Value="#5500F0FF" />
    </Style>
    <Style Selector="TextBox:focus-within /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="#00F0FF" />
    </Style>

    <!--
    ================================================================================
    LISTBOX STYLES — Cyan left-bar on selected / hover
    ================================================================================
    -->
    <Style Selector="ListBox.peerList">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.peerList ListBoxItem">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.peerList ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PeerSelectedBrush}" />
    </Style>
    <Style Selector="ListBox.peerList ListBoxItem:selected">
        <Setter Property="BorderBrush" Value="#00F0FF" />
    </Style>
    <Style Selector="ListBox.peerList ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#18FF2D8A" />
    </Style>
    <Style Selector="ListBox.peerList ListBoxItem:pointerover">
        <Setter Property="BorderBrush" Value="#88FF2D8A" />
    </Style>

    <Style Selector="ListBox.messageList">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.messageList ListBoxItem">
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style Selector="ListBox.messageList ListBoxItem /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.messageList ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.messageList ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--
    ================================================================================
    TOGGLESWITCH (ROG: ピンクON / 灰OFF)
    ================================================================================
    -->
    <Style Selector="ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
    </Style>

    <!--
    ================================================================================
    SECTION HEADERS — 字間広めの uppercase 風 (ゲーミング感)
    ================================================================================
    -->
    <Style Selector="TextBlock.sectionHeader">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource SectionHeaderBrush}" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

    <Style Selector="TextBlock.settingLabel">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.settingDescription">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
    ================================================================================
    TAHOE DIALOG STYLES (キー名互換維持、見た目は ROG)
    ================================================================================
    -->
    <Style Selector="Border.glass-inner">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderGlowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.tahoe-primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="0.5" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderBrush" Value="#88FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <DropShadowEffect Color="#FF2D8A" BlurRadius="12" Opacity="0.6" OffsetX="0" OffsetY="0" />
        </Setter>
    </Style>
    <Style Selector="Button.tahoe-primary /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#88FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.tahoe-primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#00F0FF" />
    </Style>
    <Style Selector="Button.tahoe-primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.tahoe-primary:pointerover">
        <Setter Property="BorderBrush" Value="#00F0FF" />
        <Setter Property="Effect">
            <DropShadowEffect Color="#00F0FF" BlurRadius="20" Opacity="0.85" OffsetX="0" OffsetY="0" />
        </Setter>
    </Style>

    <!--
    ================================================================================
    UNREAD BADGE — ネオンピンクで目立つ
    ================================================================================
    -->
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Effect">
            <DropShadowEffect Color="#FF2D8A" BlurRadius="10" Opacity="0.85" OffsetX="0" OffsetY="0" />
        </Setter>
    </Style>

    <!--
    ================================================================================
    ROUTE BADGE — グロー強化版
    ================================================================================
    -->
    <Style Selector="Border.route-badge">
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="18" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- LAN (TCP 直結) — neon green -->
    <Style Selector="Border.route-badge.lan">
        <Setter Property="Background" Value="{DynamicResource GreenBrushSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GreenBrushBorder}" />
        <Setter Property="Effect">
            <DropShadowEffect Color="#00FF9D" BlurRadius="8" Opacity="0.6" OffsetX="0" OffsetY="0" />
        </Setter>
    </Style>
    <Style Selector="Border.route-badge.lan TextBlock.route-badge-text">
        <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
    </Style>

    <!-- P2P (STUN ホールパンチ) — neon cyan -->
    <Style Selector="Border.route-badge.p2p">
        <Setter Property="Background" Value="{DynamicResource BlueBrushSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BlueBrushBorder}" />
        <Setter Property="Effect">
            <DropShadowEffect Color="#00F0FF" BlurRadius="8" Opacity="0.6" OffsetX="0" OffsetY="0" />
        </Setter>
    </Style>
    <Style Selector="Border.route-badge.p2p TextBlock.route-badge-text">
        <Setter Property="Foreground" Value="{DynamicResource BlueBrush}" />
    </Style>

    <!-- Relay (Cloudflare Workers) — neon orange -->
    <Style Selector="Border.route-badge.relay">
        <Setter Property="Background" Value="{DynamicResource OrangeBrushSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OrangeBrushBorder}" />
        <Setter Property="Effect">
            <DropShadowEffect Color="#FF8800" BlurRadius="8" Opacity="0.6" OffsetX="0" OffsetY="0" />
        </Setter>
    </Style>
    <Style Selector="Border.route-badge.relay TextBlock.route-badge-text">
        <Setter Property="Foreground" Value="{DynamicResource OrangeBrush}" />
    </Style>

    <!-- 状態取得中 (Route 未確定) — muted gray。経路色が付くまでの空欄回避用 -->
    <Style Selector="Border.route-badge.pending">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Border.route-badge.pending TextBlock.route-badge-text">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    </Style>

    <!-- バッジ内のテキスト共通 — uppercase mono で技術感 -->
    <Style Selector="TextBlock.route-badge-text">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="1.5" />
        <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Segoe UI" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.route-badge-icon">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,3,0" />
    </Style>

    <!--
    ================================================================================
    SIDEBAR MENU ITEM (v1.0.38: 「➕ ペアリング先追加」「⚙ 設定」)
    ROG 風: 左から右へ流れるネオンピンクのアクセント
    ================================================================================
    -->
    <Style Selector="Button.sidebarMenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.sidebarMenuItem /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!-- pointerover は Button.Foreground 経由 (TextElement.Foreground を /template/ で
         触ると絵文字混じりテキストの再描画で hit-test ジッタ → 文字点滅するため) -->
    <Style Selector="Button.sidebarMenuItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#FF2D8A" />
    </Style>
    <Style Selector="Button.sidebarMenuItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#22FF2D8A" />
    </Style>
    <Style Selector="Button.sidebarMenuItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#3500F0FF" />
    </Style>
    <Style Selector="Button.sidebarMenuItem:pressed">
        <Setter Property="BorderBrush" Value="#00F0FF" />
    </Style>
    <!-- 選択中（設定タブ ON）— ピアリスト選択と同じシアン左アクセント + ハイライト背景。
         宛先リストと設定を同一タブグループに見せるための active 表示 -->
    <Style Selector="Button.sidebarMenuItem.selected">
        <Setter Property="BorderBrush" Value="#00F0FF" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.sidebarMenuItem.selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PeerSelectedBrush}" />
    </Style>

</Styles>
