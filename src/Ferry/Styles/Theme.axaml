<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- === Avalonia FluentTheme アクセントカラー上書き === -->
        <Color x:Key="SystemAccentColor">#007AFF</Color>
        <Color x:Key="SystemAccentColorDark1">#0A84FF</Color>
        <Color x:Key="SystemAccentColorDark2">#409CFF</Color>
        <Color x:Key="SystemAccentColorDark3">#66B3FF</Color>
        <Color x:Key="SystemAccentColorLight1">#0064D2</Color>
        <Color x:Key="SystemAccentColorLight2">#004DA6</Color>
        <Color x:Key="SystemAccentColorLight3">#003580</Color>

        <!-- === ダークテーマ色（デフォルト） === -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#161618" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#222224" />
        <SolidColorBrush x:Key="GlassBrush" Color="#2A2A2E" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2A2A2C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#007AFF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#0A84FF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F7" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E8E93" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#636366" />
        <SolidColorBrush x:Key="GreenBrush" Color="#30D158" />
        <SolidColorBrush x:Key="RedBrush" Color="#FF453A" />
        <SolidColorBrush x:Key="YellowBrush" Color="#FFD60A" />
        <SolidColorBrush x:Key="BlueBrush" Color="#0A84FF" />
        <SolidColorBrush x:Key="OrangeBrush" Color="#FF9F0A" />

        <!-- === 接続経路バッジ用ソフトカラー (背景・ボーダー tint) === -->
        <!-- Tahoe / Apple のソフト tint パターン: メインカラーを 16-24% アルファで透過 -->
        <SolidColorBrush x:Key="GreenBrushSoft" Color="#3030D158" />
        <SolidColorBrush x:Key="GreenBrushBorder" Color="#6630D158" />
        <SolidColorBrush x:Key="BlueBrushSoft" Color="#300A84FF" />
        <SolidColorBrush x:Key="BlueBrushBorder" Color="#660A84FF" />
        <SolidColorBrush x:Key="OrangeBrushSoft" Color="#30FF9F0A" />
        <SolidColorBrush x:Key="OrangeBrushBorder" Color="#66FF9F0A" />
        <SolidColorBrush x:Key="BorderBrush" Color="#38383A" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#1C1C1E" />
        <SolidColorBrush x:Key="OverlayBrush" Color="#80000000" />
        <SolidColorBrush x:Key="BadgeBrush" Color="#FF453A" />
        <SolidColorBrush x:Key="PeerSelectedBrush" Color="#1A3A5C" />
        <SolidColorBrush x:Key="OfflineBrush" Color="#FF453A" />

        <!-- Tahoe ダイアログ用ブラシ（AddMemberWindow, SelfUpdateWindow 等） -->
        <SolidColorBrush x:Key="TahoeWindowBgBrush" Color="#161618" />
        <SolidColorBrush x:Key="TahoeTextPrimaryBrush" Color="#F5F5F7" />
        <SolidColorBrush x:Key="TahoeTextSecondaryBrush" Color="#8E8E93" />
        <SolidColorBrush x:Key="TahoeTextTertiaryBrush" Color="#636366" />

        <!-- === 共通サイズ === -->
        <x:Double x:Key="SidebarWidth">220</x:Double>
        <x:Double x:Key="TitleBarHeight">36</x:Double>
        <CornerRadius x:Key="SmallCornerRadius">4</CornerRadius>
        <CornerRadius x:Key="MediumCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="LargeCornerRadius">16</CornerRadius>
        <CornerRadius x:Key="BubbleCornerRadius">16</CornerRadius>
        <Thickness x:Key="BubblePadding">12,8</Thickness>
    </Styles.Resources>

    <!-- === Button スタイル === -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>

    <Style Selector="Button.sidebar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.sidebar:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource RedBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- === TextBox スタイル === -->
    <Style Selector="TextBox.search">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- === ListBox スタイル === -->
    <Style Selector="ListBox.peerList">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.peerList ListBoxItem">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.peerList ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PeerSelectedBrush}" />
    </Style>
    <Style Selector="ListBox.peerList ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>

    <Style Selector="ListBox.messageList">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.messageList ListBoxItem">
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style Selector="ListBox.messageList ListBoxItem /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.messageList ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.messageList ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- === ToggleSwitch スタイル === -->
    <Style Selector="ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
    </Style>

    <!-- === セクションヘッダー === -->
    <Style Selector="TextBlock.sectionHeader">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

    <Style Selector="TextBlock.settingLabel">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.settingDescription">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- === Tahoe ダイアログ用スタイル === -->
    <Style Selector="Border.glass-inner">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.tahoe-primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.tahoe-primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>

    <!-- === 未読バッジ === -->
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ====================================================================
         接続経路バッジ (Route Badge) — メンバーリストで接続方式を可視化
         Tahoe / Apple System Status pill 風: 薄い tint 背景 + 同色細枠 + 同色文字
         クラス: route-badge + {lan|p2p|relay} の組み合わせ
         ==================================================================== -->
    <Style Selector="Border.route-badge">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="18" />
        <!-- 既定（接続経路未確定時）は透明にして実質非表示にする保険 -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- LAN 直接 (TCP) — 緑 -->
    <Style Selector="Border.route-badge.lan">
        <Setter Property="Background" Value="{DynamicResource GreenBrushSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GreenBrushBorder}" />
    </Style>
    <Style Selector="Border.route-badge.lan TextBlock.route-badge-text">
        <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
    </Style>

    <!-- P2P (STUN ホールパンチ) — 青 -->
    <Style Selector="Border.route-badge.p2p">
        <Setter Property="Background" Value="{DynamicResource BlueBrushSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BlueBrushBorder}" />
    </Style>
    <Style Selector="Border.route-badge.p2p TextBlock.route-badge-text">
        <Setter Property="Foreground" Value="{DynamicResource BlueBrush}" />
    </Style>

    <!-- リレー (TURN/WebSocket) — オレンジ -->
    <Style Selector="Border.route-badge.relay">
        <Setter Property="Background" Value="{DynamicResource OrangeBrushSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OrangeBrushBorder}" />
    </Style>
    <Style Selector="Border.route-badge.relay TextBlock.route-badge-text">
        <Setter Property="Foreground" Value="{DynamicResource OrangeBrush}" />
    </Style>

    <!-- バッジ内のテキスト共通スタイル -->
    <Style Selector="TextBlock.route-badge-text">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.route-badge-icon">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,3,0" />
    </Style>

    <!-- ====================================================================
         サイドバー下部メニューアイテム (v1.0.38 追加)
         「➕ ペアリング先追加」「⚙ 設定」のような左寄せリスト風アイテム
         ==================================================================== -->
    <Style Selector="Button.sidebarMenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.sidebarMenuItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.sidebarMenuItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>

</Styles>
