<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ferry.ViewModels"
        x:Class="Ferry.Views.AddMemberWindow"
        x:DataType="vm:ConnectionViewModel"
        Title="{DynamicResource Text.Tab.AddMember}"
        Width="380"
        Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource TahoeWindowBgBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36">

    <Grid RowDefinitions="36,*">
        <Border Grid.Row="0" Background="Transparent" IsHitTestVisible="False" />

        <StackPanel Grid.Row="1" Spacing="16" Margin="24,0,24,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- タイトル -->
            <TextBlock Text="{DynamicResource Text.Tab.AddMember}"
                       FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TahoeTextPrimaryBrush}" />

            <!-- ステータステキスト -->
            <TextBlock Text="{Binding StatusText}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TahoeTextSecondaryBrush}"
                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- QR コード表示 -->
            <Border Classes="glass-inner" Padding="16"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding QrCodeImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Image Source="{Binding QrCodeImage}"
                       Width="200" Height="200"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Border>

            <!-- v1.0.38: ペアリングコード共有 (URL ではなく 32 文字 hex)。
                 ブラウザに URL を開かれる事故を防ぐ目的でただの文字列に変更 -->
            <StackPanel Spacing="8"
                        IsVisible="{Binding PairingCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{DynamicResource Text.Connection.PairingCode}"
                           FontSize="11"
                           Foreground="{StaticResource TahoeTextTertiaryBrush}"
                           HorizontalAlignment="Center" />
                <Border Classes="glass-inner" Padding="8,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding PairingCode}"
                                   FontSize="11"
                                   FontFamily="Consolas, 'Courier New', monospace"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TahoeTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="tahoe-primary"
                                FontSize="11"
                                Margin="8,0,0,0"
                                Command="{Binding CopyPairingCodeCommand}">
                            <Panel>
                                <TextBlock Text="{DynamicResource Text.Connection.Copy}"
                                           IsVisible="{Binding !IsLinkCopied}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Text.Connection.Copied}"
                                           IsVisible="{Binding IsLinkCopied}"
                                           HorizontalAlignment="Center" />
                            </Panel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 区切り線 -->
            <Border Height="1"
                    Background="{StaticResource TahoeTextTertiaryBrush}"
                    Opacity="0.3"
                    Margin="0,4,0,4" />

            <!-- v1.0.38: 相手のペアリングコードを貼り付け (URL ではなく 32 文字 hex) -->
            <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource Text.Connection.PairFromCode.Header}"
                           FontSize="11"
                           Foreground="{StaticResource TahoeTextTertiaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource Text.Connection.PairFromCode.Hint}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TahoeTextTertiaryBrush}" />
                <TextBox x:Name="PairFromCodeInput"
                         FontSize="11"
                         FontFamily="Consolas, 'Courier New', monospace"
                         PlaceholderText="{DynamicResource Text.Connection.PairFromCode.Placeholder}"
                         Text="{Binding PairFromCodeText, Mode=TwoWay}" />
                <TextBlock Text="{Binding PairFromCodeStatus}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Foreground="{Binding PairFromCodeStatusBrush}"
                           IsVisible="{Binding PairFromCodeStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Button Classes="tahoe-primary"
                        FontSize="11"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding PairFromCodeCommand}"
                        IsEnabled="{Binding PairFromCodeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{DynamicResource Text.Connection.PairFromCode.Button}" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
