<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Ferry.ViewModels"
             xmlns:m="using:Ferry.Models"
             xmlns:controls="using:Ferry.Controls"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
             x:Class="Ferry.Views.TransferView"
             x:DataType="vm:TransferViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- ヘッダー: ピア名 + 経路バッジ + クリア + 送信ボタン -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceVariantBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <!-- ピア名 + 経路バッジ。SelectedPeer を中間 DataContext に置き子は直接参照する。 -->
                <StackPanel VerticalAlignment="Center" Spacing="4"
                            x:DataType="m:PairedPeer"
                            DataContext="{Binding ((vm:MainWindowViewModel)DataContext).Connection.SelectedPeer,
                                                  RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border Classes="route-badge"
                            Classes.lan="{Binding IsLanRoute}"
                            Classes.p2p="{Binding IsP2pRoute}"
                            Classes.relay="{Binding IsRelayRoute}"
                            IsVisible="{Binding IsConnected}"
                            ToolTip.Tip="{Binding RouteBadgeTooltip}"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="route-badge-icon route-badge-text"
                                       Text="{Binding RouteBadgeIcon}" />
                            <TextBlock Classes="route-badge-text"
                                       Text="{Binding RouteBadgeLabel}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- 履歴クリア（選択中ピアの完了/失敗/キャンセル分のみ） -->
                <Button Grid.Column="1" Classes="icon"
                        Content="🗑" FontSize="15"
                        VerticalAlignment="Center" Margin="0,0,8,0"
                        ToolTip.Tip="{DynamicResource Text.Transfer.ClearHistory}"
                        IsVisible="{Binding HasTransfers}"
                        Command="{Binding ClearHistoryCommand}" />
                <!-- 受信ファイルの保存先を OS ファイラで開く。保存先パス自体の表示・変更は設定画面側。 -->
                <Button Grid.Column="2" Classes="pink" Margin="0,0,8,0"
                        Content="{DynamicResource Text.SaveBar.Open}"
                        ToolTip.Tip="{DynamicResource Text.SaveBar.Tooltip}"
                        Click="OnOpenSaveDirClick" />
                <Button Grid.Column="3" Classes="accent"
                        Content="{DynamicResource Text.Transfer.SendFile}"
                        Command="{Binding BrowseAndSendFilesCommand}" />
            </Grid>
        </Border>

        <!-- 転送リスト（選択中ピア分のみ） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Panel>
                <ItemsControl ItemsSource="{Binding VisibleTransfers}"
                              IsVisible="{Binding HasTransfers}"
                              Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:TransferItem">
                            <Border Background="{DynamicResource SurfaceVariantBrush}"
                                    CornerRadius="8" Padding="12,10" Margin="0,4">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <!-- アイコン -->
                                    <TextBlock Grid.Column="0" Grid.RowSpan="4"
                                               Text="📄" FontSize="24"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <!-- 方向アイコン + ファイル名（左）/ 送受信日時（右） -->
                                    <Grid Grid.Column="1" Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding DirectionSymbol}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="14" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CreatedAtText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </Grid>

                                    <!-- サイズ・進捗・状態・補足(リトライ等)。状態/レートはサイズ表示と同じ色・サイズ・縦位置に揃える。 -->
                                    <StackPanel Grid.Column="1" Grid.Row="1"
                                                Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding DisplayInfo}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding StateText}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Note}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TahoeAccentBrush}"
                                                   IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <!-- 転送中の平均レート(bps)。InProgress 時のみ非空。サイズ表示と同じ色・サイズ。 -->
                                        <TextBlock Text="{Binding RateText}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   IsVisible="{Binding RateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>

                                    <!-- ファイルのフルパス (送信なら元、受信なら保存先)。収まらない時は左へ流す。 -->
                                    <controls:MarqueeTextBlock Grid.Column="1" Grid.Row="2"
                                               Text="{Binding DisplayFilePath}"
                                               FontSize="11"
                                               Height="16"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               ToolTip.Tip="{Binding DisplayFilePath}"
                                               IsVisible="{Binding DisplayFilePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                    <!-- 進捗バー: 転送中のみ表示 -->
                                    <ProgressBar Grid.Column="1" Grid.Row="3"
                                                 Minimum="0" Maximum="1"
                                                 Value="{Binding Progress}"
                                                 IsVisible="{Binding IsInProgress}"
                                                 Height="3"
                                                 Margin="0,6,0,0"
                                                 CornerRadius="2"
                                                 Foreground="{DynamicResource TahoeAccentBrush}"
                                                 Background="{DynamicResource BorderBrush}" />

                                    <!-- 行ごとの操作ボタン。
                                         旧 Content="⏸/▶/🔄/✕/🗑" はフォントグリフ依存で、mac の既定フォント Inter が
                                         当該グリフを持たず化けた（宛先リストの 3 点リーダーと同根）。フォント非依存・
                                         クロス OS 同一表示のためベクター Path (12x12) に差し替え。Fill/Stroke は
                                         $parent[Button].Foreground バインドで Button.icon:pointerover の白色化に追従する。 -->
                                    <StackPanel Grid.Column="2" Grid.RowSpan="4"
                                                Orientation="Horizontal" Spacing="2"
                                                VerticalAlignment="Center">
                                        <Button Classes="icon"
                                                ToolTip.Tip="{DynamicResource Text.Transfer.Pause}"
                                                IsVisible="{Binding CanPause}"
                                                Command="{Binding ((vm:TransferViewModel)DataContext).PauseTransferCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding TransferId}">
                                            <!-- 一時停止: 縦バー 2 本 -->
                                            <Path Fill="{Binding $parent[Button].Foreground}"
                                                  Data="M 2,1 L 5,1 L 5,11 L 2,11 Z M 7,1 L 10,1 L 10,11 L 7,11 Z" />
                                        </Button>
                                        <Button Classes="icon"
                                                ToolTip.Tip="{DynamicResource Text.Transfer.Resume}"
                                                IsVisible="{Binding CanResumeSend}"
                                                Command="{Binding ((vm:TransferViewModel)DataContext).ResumeSendCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding TransferId}">
                                            <!-- 再開: 右向き三角 -->
                                            <Path Fill="{Binding $parent[Button].Foreground}"
                                                  Data="M 3,1.5 L 10.5,6 L 3,10.5 Z" />
                                        </Button>
                                        <Button Classes="icon"
                                                ToolTip.Tip="{DynamicResource Text.Transfer.ResumeSuspended}"
                                                IsVisible="{Binding CanResumeSuspended}"
                                                Command="{Binding ((vm:TransferViewModel)DataContext).ResumeTransferCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding TransferId}">
                                            <!-- 中断再開: 右向き三角 -->
                                            <Path Fill="{Binding $parent[Button].Foreground}"
                                                  Data="M 3,1.5 L 10.5,6 L 3,10.5 Z" />
                                        </Button>
                                        <Button Classes="icon"
                                                ToolTip.Tip="{DynamicResource Text.Transfer.Resend}"
                                                IsVisible="{Binding CanResend}"
                                                Command="{Binding ((vm:TransferViewModel)DataContext).ResendCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding TransferId}">
                                            <!-- 再送: 270° リング矢印（外弧→矢じり→内弧の単一塗りつぶしパス） -->
                                            <Path Fill="{Binding $parent[Button].Foreground}"
                                                  Data="M 11.2,6 A 5.2,5.2 0 1 1 6,0.8 L 6,0 L 9,1.7 L 6,3.4 L 6,2.6 A 3.4,3.4 0 1 0 9.4,6 Z" />
                                        </Button>
                                        <Button Classes="icon"
                                                ToolTip.Tip="{DynamicResource Text.Transfer.Cancel}"
                                                IsVisible="{Binding CanCancel}"
                                                Command="{Binding ((vm:TransferViewModel)DataContext).CancelTransferCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding TransferId}">
                                            <!-- 中止: ✕（ストローク 2 本） -->
                                            <Path Stroke="{Binding $parent[Button].Foreground}"
                                                  StrokeThickness="1.7" StrokeLineCap="Round"
                                                  Data="M 2,2 L 10,10 M 10,2 L 2,10" />
                                        </Button>
                                        <Button Classes="icon"
                                                ToolTip.Tip="{DynamicResource Text.Transfer.Delete}"
                                                IsVisible="{Binding CanDelete}"
                                                Command="{Binding ((vm:TransferViewModel)DataContext).DeleteTransferCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding TransferId}">
                                            <!-- 削除: ゴミ箱（取っ手 + 蓋 + 台形ボディ） -->
                                            <Path Fill="{Binding $parent[Button].Foreground}"
                                                  Data="M 4.5,0.5 L 7.5,0.5 L 7.5,1.8 L 4.5,1.8 Z M 1,2.4 L 11,2.4 L 11,3.6 L 1,3.6 Z M 2.2,4.6 L 9.8,4.6 L 9.1,11.5 L 2.9,11.5 Z" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 転送履歴が空の場合 -->
                <StackPanel IsVisible="{Binding !HasTransfers}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="8">
                    <TextBlock Text="{DynamicResource Text.Transfer.DropHere}"
                               FontSize="16"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Text.Transfer.OrClickSend}"
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Panel>
        </ScrollViewer>

        <!-- 承認待ちパネル -->
        <Border Grid.Row="2" IsVisible="{Binding HasPendingApproval}"
                Background="{DynamicResource SurfaceVariantBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="8">
            <ItemsControl ItemsSource="{Binding PendingApprovals}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:TransferItem">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="8" Padding="12,8" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}"
                                               FontSize="14" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding FileSizeText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="accent" Margin="8,0"
                                        Content="{DynamicResource Text.Transfer.Accept}"
                                        Command="{Binding ((vm:TransferViewModel)DataContext).ApproveTransferCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding TransferId}" />
                                <Button Grid.Column="2" Classes="pink"
                                        Content="{DynamicResource Text.Transfer.Reject}"
                                        Command="{Binding ((vm:TransferViewModel)DataContext).RejectTransferCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding TransferId}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>

</UserControl>
