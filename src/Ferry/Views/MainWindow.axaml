<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ferry.ViewModels"
        xmlns:m="using:Ferry.Models"
        xmlns:v="using:Ferry.Views"
        xmlns:conv="using:Ferry.Converters"
        x:Class="Ferry.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Ferry"
        Width="800"
        Height="540"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Blur,None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        DragDrop.AllowDrop="True">

    <!-- OnlineStatusBrush コンバータは {x:Static conv:OnlineStatusToBrushConverter.Instance} で参照する。
         Window.Resources での個別インスタンス化は不要（N-16 統一）。-->


    <Panel>
        <!-- ROG NEON: 深宇宙黒アクリルベース -->
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                             TintColor="{DynamicResource AcrylicTintColor}"
                                             TintOpacity="0.92"
                                             MaterialOpacity="0.75" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <!-- ROG NEON: 左上シアン → 右下ピンク 斜め走る大型グロー
             (上下のビームは UI 要素と重なって読みにくかったので撤去、
              背景は控えめな斜めグラデだけにして、ボタン視認性を優先) -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#1800F0FF" Offset="0.0" />
                    <GradientStop Color="#0008101F" Offset="0.5" />
                    <GradientStop Color="#18FF2D8A" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid RowDefinitions="36,*">
            <!-- Row 0: タイトルバー（透明） -->
            <Border Grid.Row="0" Background="Transparent" IsHitTestVisible="False" />

            <!-- Row 1: メインコンテンツ 2カラム (v1.0.38: GridSplitter でドラッグ可)。
                 SidebarColumn の幅はドラッグ後に settings.json へ永続化する -->
            <Grid Grid.Row="1" x:Name="MainContentGrid">
                <Grid.ColumnDefinitions>
                    <!-- 左ペイン（サイドバー）。幅は code-behind が ColumnDefinitions[0] 経由で保存/復元 -->
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Col 0: サイドバー (ROG NEON: cyan 枠 + ほんのり glow) -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                        CornerRadius="4" Margin="8,4,4,8"
                        MinWidth="180"
                        BorderBrush="#3300F0FF"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#00F0FF" BlurRadius="20" Opacity="0.35" OffsetX="0" OffsetY="0" />
                    </Border.Effect>
                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- 検索ボックス + 並び替えメニュー + 手動更新ボタン -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="8,8">
                            <TextBox Grid.Column="0" Classes="search"
                                     Text="{Binding Connection.PeerSearchText, Mode=TwoWay}"
                                     PlaceholderText="{DynamicResource Text.Transfer.SearchPeer}" />
                            <!-- 並び替えメニュー。アイコンはフォント非依存のベクター（幅の減る 3 本線＝ソート） -->
                            <Button Grid.Column="1" Classes="icon"
                                    Margin="6,0,0,0"
                                    ToolTip.Tip="{DynamicResource Text.Peer.Sort}">
                                <StackPanel Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Rectangle Width="14" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource TextSecondaryBrush}" />
                                    <Rectangle Width="10" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource TextSecondaryBrush}" />
                                    <Rectangle Width="6" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="{DynamicResource Text.Peer.Sort.Name}"
                                                  Command="{Binding Connection.SetSortModeCommand}"
                                                  CommandParameter="{x:Static m:PeerSortMode.Name}" />
                                        <MenuItem Header="{DynamicResource Text.Peer.Sort.LastTransfer}"
                                                  Command="{Binding Connection.SetSortModeCommand}"
                                                  CommandParameter="{x:Static m:PeerSortMode.LastTransfer}" />
                                        <MenuItem Header="{DynamicResource Text.Peer.Sort.Route}"
                                                  Command="{Binding Connection.SetSortModeCommand}"
                                                  CommandParameter="{x:Static m:PeerSortMode.Route}" />
                                        <MenuItem Header="{DynamicResource Text.Peer.Sort.Transferring}"
                                                  Command="{Binding Connection.SetSortModeCommand}"
                                                  CommandParameter="{x:Static m:PeerSortMode.Transferring}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Grid.Column="2" Classes="icon"
                                    Content="🔄"
                                    FontSize="14"
                                    Margin="6,0,0,0"
                                    ToolTip.Tip="{DynamicResource Text.Sidebar.RefreshPeers}"
                                    Command="{Binding Connection.RefreshPeersCommand}" />
                        </Grid>

                        <!-- ピアリスト -->
                        <ListBox Grid.Row="1" Classes="peerList"
                                 ItemsSource="{Binding Connection.VisiblePeers}"
                                 SelectedItem="{Binding Connection.SelectedPeer, Mode=TwoWay}"
                                 x:Name="PeerListBox">
                            <ListBox.DataTemplates>
                                <!-- セクション見出し（📌ピン / 🟢オンライン / ⚪オフライン）。
                                     行は選択・フォーカス不可（code-behind OnPeerListContainerPrepared で抑止）-->
                                <DataTemplate x:DataType="m:PeerListSection">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,8,2,2">
                                        <TextBlock Text="{Binding Icon}" FontSize="10" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                                <DataTemplate x:DataType="m:PairedPeer">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                        <!-- オンラインインジケーター -->
                                        <Ellipse Grid.Column="0" Width="10" Height="10"
                                                 Fill="{Binding IsOnline, Converter={x:Static conv:OnlineStatusToBrushConverter.Instance}}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />

                                        <!-- ピア名 + 接続経路バッジ (Tahoe ピル型) -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <!-- 1 段目: 名前 -->
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="14" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />

                                            <!-- 2 段目: 接続経路バッジ + 接続状態テキスト (バッジの右側)。
                                                 バッジは常時表示し、Route 未確定時は pending クラスで
                                                 「状態取得中」を dimmed 表示する（空欄を避ける）。
                                                 Classes.lan/p2p/relay/pending の bool バインドで色を切替 -->
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Classes="route-badge"
                                                        Classes.lan="{Binding IsLanRoute}"
                                                        Classes.p2p="{Binding IsP2pRoute}"
                                                        Classes.relay="{Binding IsRelayRoute}"
                                                        Classes.pending="{Binding IsRouteUnknown}"
                                                        ToolTip.Tip="{Binding RouteBadgeTooltip}"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Classes="route-badge-icon route-badge-text"
                                                                   Text="{Binding RouteBadgeIcon}" />
                                                        <TextBlock Classes="route-badge-text"
                                                                   Text="{Binding RouteBadgeLabel}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Stage 6: 進行中転送バッジ。peer に紐づく転送が 1 件以上ある間だけ
                                                     表示する。複数 peer 並列転送が解禁された後 (Stage 4) の視覚的フィードバック。 -->
                                                <Border Classes="route-badge transferring-badge"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding IsTransferring}"
                                                        ToolTip.Tip="このピアへの進行中転送">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Classes="route-badge-icon route-badge-text"
                                                                   Text="🔄" />
                                                        <TextBlock Classes="route-badge-text"
                                                                   Text="{Binding ActiveTransferCount}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- 接続状態テキスト (未接続時のヒント等) — バッジの右に並べる -->
                                                <TextBlock Text="{Binding ConnectionStatusText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           VerticalAlignment="Center"
                                                           MaxLines="1" TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding ConnectionStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 3 点リーダー → サブメニュー（削除など）。
                                             ListBoxItem へのバブルを止めて SelectedPeer 書き換えを防ぐ。
                                             旧 Content="&#x22EF;"(U+22EF) はフォントグリフ依存で、既定フォント Inter が
                                             当該グリフを持たず環境によって ≡ 状に化けた。フォント非依存・AOT 安全・
                                             クロス OS 同一表示のため Ellipse 3 個のベクター横 3 点に差し替えた。 -->
                                        <Button Grid.Column="2"
                                                ToolTip.Tip="{DynamicResource Text.Member.Menu}"
                                                VerticalAlignment="Center"
                                                MinWidth="28" Height="28"
                                                Padding="6,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                PointerPressed="OnDotMenuPointerPressed">
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Spacing="3">
                                                <Ellipse Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}" />
                                                <Ellipse Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}" />
                                                <Ellipse Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <!-- ピン留め / 解除（VM のトグルコマンドへ委譲・peers.json 永続化）-->
                                                    <MenuItem Header="{DynamicResource Text.Member.TogglePin}"
                                                              Click="OnTogglePinClick" />
                                                    <Separator />
                                                    <!-- 削除前に確認ダイアログを出すため、Command バインドではなく Click を介す -->
                                                    <MenuItem Header="{DynamicResource Text.Member.Delete}"
                                                              Click="OnDeletePeerClick" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.DataTemplates>
                        </ListBox>

                        <!-- v1.0.38: サイドバー下部メニューをリスト風に (下詰めアイコン + ラベル) -->
                        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0" Padding="0,4">
                            <StackPanel Orientation="Vertical" Spacing="2">
                                <Button Classes="sidebarMenuItem"
                                        Classes.selected="{Binding IsAddPeerMode}"
                                        Command="{Binding ShowAddPeerCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="➕" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Text.Sidebar.AddPeer}"
                                                   FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="sidebarMenuItem"
                                        Classes.selected="{Binding IsSettingsMode}"
                                        Command="{Binding ToggleSettingsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="⚙" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Text.Sidebar.Settings}"
                                                   FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- v1.0.38: 左右ペイン仕切り (ROG NEON: 中央にシアンライン) -->
                <GridSplitter Grid.Column="1"
                              x:Name="PaneSplitter"
                              Width="4"
                              Background="#5500F0FF"
                              ResizeBehavior="PreviousAndNext"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch" />

                <!-- Col 2: メインパネル (ROG NEON: pink 枠 + ほんのり glow) -->
                <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="4" Margin="4,4,8,8" ClipToBounds="True"
                        MinWidth="300"
                        BorderBrush="#33FF2D8A"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF2D8A" BlurRadius="20" Opacity="0.3" OffsetX="0" OffsetY="0" />
                    </Border.Effect>
                <Panel>
                    <!-- 転送ビュー -->
                    <v:TransferView x:Name="TransferViewControl"
                                    DataContext="{Binding Transfer}">
                        <v:TransferView.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="((vm:MainWindowViewModel)DataContext).IsSettingsMode"
                                         RelativeSource="{RelativeSource AncestorType=Window}"
                                         Converter="{x:Static BoolConverters.Not}" />
                                <Binding Path="((vm:MainWindowViewModel)DataContext).IsAddPeerMode"
                                         RelativeSource="{RelativeSource AncestorType=Window}"
                                         Converter="{x:Static BoolConverters.Not}" />
                                <Binding Path="((vm:MainWindowViewModel)DataContext).Connection.SelectedPeer"
                                         RelativeSource="{RelativeSource AncestorType=Window}"
                                         Converter="{x:Static ObjectConverters.IsNotNull}" />
                            </MultiBinding>
                        </v:TransferView.IsVisible>
                    </v:TransferView>

                    <!-- 設定ビュー -->
                    <v:SettingsView DataContext="{Binding Settings}"
                                    IsVisible="{Binding ((vm:MainWindowViewModel)DataContext).IsSettingsMode,
                                                        RelativeSource={RelativeSource AncestorType=Window}}" />

                    <!-- ペアリング先追加ビュー（右ペイン内タブ。旧 AddMemberWindow を統合） -->
                    <v:AddMemberView DataContext="{Binding Connection}"
                                     IsVisible="{Binding ((vm:MainWindowViewModel)DataContext).IsAddPeerMode,
                                                         RelativeSource={RelativeSource AncestorType=Window}}" />

                    <!-- 空ビュー（ピア未選択時） -->
                    <Border IsVisible="False" x:Name="EmptyView">
                        <TextBlock Text="{DynamicResource Text.Transfer.SelectMember}"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Panel>
                </Border>
            </Grid>
        </Grid>

        <!-- ドロップオーバーレイ (ROG NEON: シアン枠 + ピンクグロー、ドロップ＝戦闘モード突入感) -->
        <Border x:Name="DropOverlay" IsVisible="False" ZIndex="100"
                Background="{DynamicResource OverlayBrush}" IsHitTestVisible="True"
                DragDrop.AllowDrop="True">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="56,40"
                    BorderBrush="#00F0FF" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect Color="#FF2D8A" BlurRadius="40" Opacity="0.85" OffsetX="0" OffsetY="0" />
                </Border.Effect>
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource Text.Drop.Message}"
                               FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Text.Drop.Description}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Panel>

</Window>
