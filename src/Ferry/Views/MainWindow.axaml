<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="using:AvaloniaWebView"
        x:Class="Ferry.Views.MainWindow"
        Title="Ferry"
        Width="800"
        Height="540"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Blur,None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="36"
        DragDrop.AllowDrop="True">

    <Panel>
        <!-- ダーク背景フォールバック -->
        <Border Background="#161618" Opacity="0.92"
                IsHitTestVisible="False" />

        <Grid RowDefinitions="36,*">
            <!-- タイトルバー（ドラッグ領域） -->
            <Border Grid.Row="0" Background="Transparent" IsHitTestVisible="False" />

            <!-- 全画面 WebView（Url 設定で初期化をトリガー） -->
            <wv:WebView Grid.Row="1" x:Name="MainWebView" Margin="0"
                        Url="about:blank" />
        </Grid>

        <!-- ドロップオーバーレイ -->
        <Border x:Name="DropOverlay" IsVisible="False" ZIndex="100"
                Background="#80000000" IsHitTestVisible="True"
                DragDrop.AllowDrop="True">
            <Border Background="#1E1E20" CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="48,32"
                    BorderBrush="#12FFFFFF" BorderThickness="1">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="Drop files to transfer"
                               FontSize="16" Foreground="#F5F5F7"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Dropped files will be sent to the connected device"
                               FontSize="11" Foreground="#4DEBEBF5"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Panel>

</Window>
