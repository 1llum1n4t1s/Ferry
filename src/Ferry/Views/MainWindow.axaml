<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ferry.ViewModels"
        xmlns:views="using:Ferry.Views"
        x:Class="Ferry.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Ferry"
        Width="720"
        Height="480"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Blur,None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="36"
        DragDrop.AllowDrop="True">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Panel>

        <!-- === 半透明ダーク背景（壁紙の透過を抑える） === -->
        <Border Background="{StaticResource TahoeWindowBgBrush}" Opacity="0.92" />

        <!-- === メインコンテンツ === -->
        <Grid RowDefinitions="36,*">

            <!-- タイトルバー領域 -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    IsHitTestVisible="False" />

            <!-- サイドバー＋コンテンツ -->
            <TabControl x:Name="SidebarTabs" Grid.Row="1" Classes="sidebar"
                        Margin="16,0,16,16"
                        Background="Transparent"
                        DragDrop.AllowDrop="True">

                <!-- メンバーリスト -->
                <TabItem Header="{DynamicResource Text.Tab.Members}">
                    <views:ConnectionPanel DataContext="{Binding Connection}" />
                </TabItem>

                <!-- メンバー追加 -->
                <TabItem Header="{DynamicResource Text.Tab.AddMember}">
                    <views:AddMemberPanel DataContext="{Binding Connection}" />
                </TabItem>

                <!-- 送信履歴 -->
                <TabItem Header="{DynamicResource Text.Tab.Transfer}">
                    <views:TransferPanel DataContext="{Binding Transfer}" />
                </TabItem>

                <!-- 設定 -->
                <TabItem Header="{DynamicResource Text.Tab.Settings}">
                    <ScrollViewer>
                        <views:SettingsPanel DataContext="{Binding Settings}" />
                    </ScrollViewer>
                </TabItem>

            </TabControl>

        </Grid>

        <!-- === ドラッグ＆ドロップオーバーレイ（ウィンドウ全体） === -->
        <Border x:Name="DropOverlay"
                IsVisible="False"
                Background="#CC1A1A1E"
                IsHitTestVisible="True"
                DragDrop.AllowDrop="True"
                ZIndex="100">
            <Border Classes="glass-card"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="48,32">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <!-- ドロップアイコン -->
                    <Border Background="{StaticResource TahoeAccentMutedBrush}"
                            CornerRadius="28"
                            Width="56" Height="56"
                            HorizontalAlignment="Center">
                        <PathIcon Width="28" Height="28"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TahoeAccentBrush}"
                                  Data="M9 16h6v-6h4l-7-7-7 7h4v6zm-4 2h14v2H5v-2z" />
                    </Border>
                    <TextBlock Text="{DynamicResource Text.Drop.Message}"
                               Classes="header"
                               FontSize="16"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Text.Drop.Description}"
                               Classes="caption"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>

    </Panel>

</Window>
