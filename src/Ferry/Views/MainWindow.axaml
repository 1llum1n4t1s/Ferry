<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ferry.ViewModels"
        xmlns:m="using:Ferry.Models"
        xmlns:v="using:Ferry.Views"
        xmlns:conv="using:Ferry.Converters"
        x:Class="Ferry.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Ferry"
        Width="800"
        Height="540"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Blur,None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        DragDrop.AllowDrop="True">

    <!-- OnlineStatusBrush コンバータは {x:Static conv:OnlineStatusToBrushConverter.Instance} で参照する。
         Window.Resources での個別インスタンス化は不要（N-16 統一）。-->


    <Panel>
        <!-- アクリル背景 -->
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                             TintColor="#161618"
                                             TintOpacity="0.85"
                                             MaterialOpacity="0.65" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <Grid RowDefinitions="36,*">
            <!-- Row 0: タイトルバー（透明） -->
            <Border Grid.Row="0" Background="Transparent" IsHitTestVisible="False" />

            <!-- Row 1: メインコンテンツ 2カラム -->
            <Grid Grid.Row="1" ColumnDefinitions="220,*">

                <!-- Col 0: サイドバー -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                        CornerRadius="12" Margin="8,4,4,8"
                        ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- 検索ボックス -->
                        <TextBox Grid.Row="0" Classes="search"
                                 PlaceholderText="{DynamicResource Text.Transfer.SearchPeer}"
                                 Margin="8,8" />

                        <!-- ピアリスト -->
                        <ListBox Grid.Row="1" Classes="peerList"
                                 ItemsSource="{Binding Connection.PairedPeers}"
                                 SelectedItem="{Binding Connection.SelectedPeer, Mode=TwoWay}"
                                 x:Name="PeerListBox">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="m:PairedPeer">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                        <!-- オンラインインジケーター -->
                                        <Ellipse Grid.Column="0" Width="10" Height="10"
                                                 Fill="{Binding IsOnline, Converter={x:Static conv:OnlineStatusToBrushConverter.Instance}}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />

                                        <!-- ピア名 + 接続経路バッジ (Tahoe ピル型) -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <!-- 1 段目: 名前 + 経路バッジを横並び -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding DisplayName}"
                                                           FontSize="14" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />

                                                <!-- 接続経路バッジ: Route が確定したときだけ表示
                                                     Classes.lan/p2p/relay の bool バインドで色を切替 -->
                                                <Border Grid.Column="1"
                                                        Classes="route-badge"
                                                        Classes.lan="{Binding IsLanRoute}"
                                                        Classes.p2p="{Binding IsP2pRoute}"
                                                        Classes.relay="{Binding IsRelayRoute}"
                                                        IsVisible="{Binding IsConnected}"
                                                        ToolTip.Tip="{Binding RouteBadgeTooltip}"
                                                        Margin="6,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Classes="route-badge-icon route-badge-text"
                                                                   Text="{Binding RouteBadgeIcon}" />
                                                        <TextBlock Classes="route-badge-text"
                                                                   Text="{Binding RouteBadgeLabel}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- 2 段目: 接続状態テキスト (未接続時のヒント等) -->
                                            <TextBlock Text="{Binding ConnectionStatusText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding ConnectionStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>

                                        <!-- 3 点リーダー → サブメニュー（削除など）。
                                             ListBoxItem へのバブルを止めて SelectedPeer 書き換えを防ぐ -->
                                        <Button Grid.Column="2"
                                                Content="&#x22EF;"
                                                ToolTip.Tip="{DynamicResource Text.Member.Menu}"
                                                VerticalAlignment="Center"
                                                MinWidth="28" Height="28"
                                                Padding="6,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="16"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                PointerPressed="OnDotMenuPointerPressed">
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <!-- 削除前に確認ダイアログを出すため、Command バインドではなく Click を介す -->
                                                    <MenuItem Header="{DynamicResource Text.Member.Delete}"
                                                              Click="OnDeletePeerClick" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- サイドバー下部ツールバー -->
                        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0" Padding="0,4">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                                <Button Classes="icon" FontSize="20"
                                        Content="+" ToolTip.Tip="メンバー追加"
                                        Command="{Binding Connection.AddNewPeerCommand}" />
                                <Button Classes="icon" FontSize="18"
                                        Content="&#x2699;" ToolTip.Tip="設定"
                                        Command="{Binding ToggleSettingsCommand}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Col 1: メインパネル（排他制御） -->
                <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="12" Margin="4,4,8,8" ClipToBounds="True">
                <Panel>
                    <!-- 転送ビュー -->
                    <v:TransferView x:Name="TransferViewControl"
                                    DataContext="{Binding Transfer}">
                        <v:TransferView.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="((vm:MainWindowViewModel)DataContext).IsSettingsMode"
                                         RelativeSource="{RelativeSource AncestorType=Window}"
                                         Converter="{x:Static BoolConverters.Not}" />
                                <Binding Path="((vm:MainWindowViewModel)DataContext).Connection.SelectedPeer"
                                         RelativeSource="{RelativeSource AncestorType=Window}"
                                         Converter="{x:Static ObjectConverters.IsNotNull}" />
                            </MultiBinding>
                        </v:TransferView.IsVisible>
                    </v:TransferView>

                    <!-- 設定ビュー -->
                    <v:SettingsView DataContext="{Binding Settings}"
                                    IsVisible="{Binding ((vm:MainWindowViewModel)DataContext).IsSettingsMode,
                                                        RelativeSource={RelativeSource AncestorType=Window}}" />

                    <!-- 空ビュー（ピア未選択時） -->
                    <Border IsVisible="False" x:Name="EmptyView">
                        <TextBlock Text="{DynamicResource Text.Transfer.SelectMember}"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Panel>
                </Border>
            </Grid>
        </Grid>

        <!-- ドロップオーバーレイ -->
        <Border x:Name="DropOverlay" IsVisible="False" ZIndex="100"
                Background="{DynamicResource OverlayBrush}" IsHitTestVisible="True"
                DragDrop.AllowDrop="True">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="48,32"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource Text.Drop.Message}"
                               FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Text.Drop.Description}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Panel>

</Window>
