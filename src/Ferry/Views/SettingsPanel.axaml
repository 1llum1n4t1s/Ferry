<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ferry.ViewModels"
             xmlns:local="using:Ferry"
             x:Class="Ferry.Views.SettingsPanel"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel Spacing="8">

            <!-- === 一般設定セクション === -->
            <TextBlock Text="{DynamicResource Text.Settings.General}" Classes="section-label"
                       Margin="0,0,0,4" />

            <!-- PC 名 -->
            <DockPanel MinHeight="40">
                <TextBlock Text="{DynamicResource Text.Settings.DisplayName}"
                           Classes="body" FontWeight="Medium"
                           VerticalAlignment="Center" DockPanel.Dock="Left" />
                <TextBox Text="{Binding DisplayName}"
                         Classes="tahoe-input"
                         Watermark="{DynamicResource Text.Settings.DisplayName.Placeholder}"
                         HorizontalAlignment="Right" Width="200" />
            </DockPanel>

            <Separator Classes="tahoe-sep" Margin="0,4" />

            <!-- === 外観セクション === -->
            <TextBlock Text="{DynamicResource Text.Settings.Appearance}" Classes="section-label"
                       Margin="0,8,0,4" />

            <!-- テーマ選択 -->
            <DockPanel MinHeight="40">
                <ComboBox ItemsSource="{Binding ThemeOptions}"
                          SelectedIndex="{Binding SelectedThemeIndex}"
                          DockPanel.Dock="Right" VerticalAlignment="Center"
                          MinWidth="160" FontSize="13" />
                <TextBlock Text="{DynamicResource Text.Settings.Theme}"
                           Classes="body" FontWeight="Medium" VerticalAlignment="Center" />
            </DockPanel>

            <!-- 言語選択 -->
            <DockPanel MinHeight="40">
                <ComboBox ItemsSource="{x:Static local:App.LocaleOptions}"
                          SelectedValue="{Binding SelectedLocale}"
                          SelectedValueBinding="{Binding Key, DataType=local:LocaleItem}"
                          DockPanel.Dock="Right" VerticalAlignment="Center"
                          MinWidth="160" FontSize="13">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="local:LocaleItem">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{DynamicResource Text.Settings.Language}"
                           Classes="body" FontWeight="Medium" VerticalAlignment="Center" />
            </DockPanel>

            <Separator Classes="tahoe-sep" Margin="0,4" />

            <!-- === ファイル保存セクション === -->
            <TextBlock Text="{DynamicResource Text.Settings.File}" Classes="section-label"
                       Margin="0,8,0,4" />

            <!-- 保存先ディレクトリ -->
            <TextBlock Text="{DynamicResource Text.Settings.SaveDirectory}"
                       Classes="body" FontWeight="Medium" />
            <DockPanel>
                <Button Content="{DynamicResource Text.Settings.SaveDirectory.Browse}"
                        Classes="tahoe-secondary"
                        Command="{Binding BrowseSaveDirectoryCommand}"
                        DockPanel.Dock="Right" VerticalAlignment="Center"
                        Margin="8,0,0,0" />
                <TextBox Text="{Binding SaveDirectory}"
                         Classes="tahoe-input" IsReadOnly="True" FontSize="11" />
            </DockPanel>

            <!-- チャット履歴保持日数 -->
            <DockPanel MinHeight="40">
                <ComboBox ItemsSource="{Binding ChatRetentionOptions}"
                          SelectedItem="{Binding ChatHistoryRetentionDays}"
                          DockPanel.Dock="Right" VerticalAlignment="Center"
                          MinWidth="100" FontSize="13">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ., Converter={x:Static local:RetentionDaysConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{DynamicResource Text.Settings.ChatRetention}"
                           Classes="body" FontWeight="Medium" VerticalAlignment="Center" />
            </DockPanel>

            <Separator Classes="tahoe-sep" Margin="0,4" />

            <!-- === 動作セクション === -->
            <TextBlock Text="{DynamicResource Text.Settings.Behavior}" Classes="section-label"
                       Margin="0,8,0,4" />

            <!-- 起動時にアプリを開く -->
            <DockPanel MinHeight="44">
                <ToggleSwitch IsChecked="{Binding RunAtStartup}"
                              Classes="tahoe-toggle"
                              DockPanel.Dock="Right" VerticalAlignment="Center" />
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Text.Settings.RunAtStartup}"
                               Classes="body" FontWeight="Medium" />
                    <TextBlock Text="{DynamicResource Text.Settings.RunAtStartup.Desc}"
                               Classes="caption" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <!-- 最小化した状態で起動する -->
            <DockPanel MinHeight="44">
                <ToggleSwitch IsChecked="{Binding StartMinimized}"
                              Classes="tahoe-toggle"
                              DockPanel.Dock="Right" VerticalAlignment="Center" />
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Text.Settings.StartMinimized}"
                               Classes="body" FontWeight="Medium" />
                    <TextBlock Text="{DynamicResource Text.Settings.StartMinimized.Desc}"
                               Classes="caption" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <!-- 閉じるボタンでトレイに最小化 -->
            <DockPanel MinHeight="44">
                <ToggleSwitch IsChecked="{Binding MinimizeToTray}"
                              Classes="tahoe-toggle"
                              DockPanel.Dock="Right" VerticalAlignment="Center" />
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Text.Settings.MinimizeToTray}"
                               Classes="body" FontWeight="Medium" />
                    <TextBlock Text="{DynamicResource Text.Settings.MinimizeToTray.Desc}"
                               Classes="caption" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <Separator Classes="tahoe-sep" Margin="0,4" />

            <!-- === バージョンセクション === -->
            <TextBlock Text="{DynamicResource Text.Settings.Version}" Classes="section-label"
                       Margin="0,8,0,4" />

            <DockPanel MinHeight="40">
                <StackPanel Orientation="Horizontal" Spacing="8"
                            DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionText}" Classes="body"
                               VerticalAlignment="Center" />
                    <Button Content="{DynamicResource Text.Settings.CheckUpdate}"
                            Classes="tahoe-secondary"
                            Command="{Binding CheckForUpdateCommand}"
                            Padding="12,4" FontSize="11" />
                </StackPanel>
                <TextBlock Text="Ferry" Classes="body" FontWeight="Medium"
                           VerticalAlignment="Center" />
            </DockPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
