<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ferry.ViewModels"
             xmlns:models="using:Ferry.Models"
             x:Class="Ferry.Views.ConnectionPanel"
             x:DataType="vm:ConnectionViewModel">

    <!-- メンバーリスト表示パネル -->
    <StackPanel Spacing="16">

        <!-- セクションヘッダー -->
        <DockPanel>
            <TextBlock Text="{DynamicResource Text.Connection.Header}" Classes="section-label"
                       VerticalAlignment="Center" />
            <!-- 接続経路（接続中のみ右端に表示） -->
            <TextBlock Text="{Binding ConnectionRouteText}"
                       Classes="caption"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       IsVisible="{Binding ConnectionRouteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </DockPanel>

        <!-- ステータステキスト -->
        <TextBlock Text="{Binding StatusText}"
                   Classes="subheader"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- 宛先選択リスト -->
        <StackPanel Spacing="8"
                    IsVisible="{Binding HasPairedPeers}">

            <ListBox ItemsSource="{Binding PairedPeers}"
                     SelectedItem="{Binding SelectedPeer}"
                     Classes="tahoe-list"
                     x:DataType="vm:ConnectionViewModel">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:PairedPeer">
                        <DockPanel>
                            <!-- 削除ボタン -->
                            <Button Command="{Binding $parent[ListBox].((vm:ConnectionViewModel)DataContext).RemovePeerCommand}"
                                    CommandParameter="{Binding PeerId}"
                                    Classes="tahoe-ghost"
                                    DockPanel.Dock="Right"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{DynamicResource Text.Connection.RemovePeer}">
                                <PathIcon Width="12" Height="12"
                                          Foreground="{StaticResource TahoeTextTertiaryBrush}"
                                          Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
                            </Button>

                            <!-- ピア情報 -->
                            <StackPanel Spacing="2">
                                <DockPanel>
                                    <!-- オンライン/オフライン信号アイコン -->
                                    <Panel Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="#30D158" IsVisible="{Binding IsOnline}" />
                                        <Ellipse Width="10" Height="10" Fill="#FF3B30" IsVisible="{Binding !IsOnline}" />
                                    </Panel>
                                    <!-- デバイス名 -->
                                    <TextBlock Text="{Binding DisplayName}"
                                               Classes="body"
                                               FontWeight="Medium" />
                                    <!-- 転送中のステータス -->
                                    <TextBlock Text="{Binding ConnectionStatusText}"
                                               Classes="caption"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding ConnectionStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </DockPanel>
                                <!-- 接続経路 -->
                                <TextBlock Text="{Binding RouteText}"
                                           FontSize="11"
                                           IsVisible="{Binding RouteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- ペアリング済みピアがない場合のヒント -->
        <TextBlock Text="{DynamicResource Text.Connection.NoMembers}"
                   Classes="caption"
                   HorizontalAlignment="Center"
                   IsVisible="{Binding !HasPairedPeers}" />

    </StackPanel>

</UserControl>
