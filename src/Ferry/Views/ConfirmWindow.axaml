<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ferry.Views.ConfirmWindow"
        Title="{DynamicResource Text.Warn}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource TahoeWindowBgBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36">

    <Grid RowDefinitions="36,*,Auto">
        <!-- タイトルバー領域（システムクロームの裏地） -->
        <Border Grid.Row="0" Background="Transparent" IsHitTestVisible="False" />

        <!-- 本文 -->
        <TextBlock Grid.Row="1" x:Name="MessageText"
                   Margin="24,12,24,20"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TahoeTextPrimaryBrush}" />

        <!-- ボタン -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Spacing="12"
                    Margin="0,0,0,24">
            <Button x:Name="BtnYes" Click="OnYes"
                    Classes="tahoe-primary"
                    MinWidth="100" Height="32" />
            <Button x:Name="BtnNo" Click="OnNo"
                    MinWidth="100" Height="32" />
        </StackPanel>
    </Grid>
</Window>
