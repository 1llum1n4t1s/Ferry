<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ferry.ViewModels"
        xmlns:m="using:Ferry.Models"
        x:Class="Ferry.Views.SelfUpdateWindow"
        x:DataType="vm:SelfUpdateViewModel"
        x:Name="ThisWindow"
        Title="Ferry — Update"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource TahoeWindowBgBrush}">

    <Panel Margin="24">

        <ContentControl Content="{Binding Data}">
            <ContentControl.DataTemplates>

                <!-- === 更新あり === -->
                <DataTemplate DataType="m:VelopackUpdate">
                    <StackPanel Spacing="12" Margin="0,8">
                        <!-- タイトル + バージョンバッジ -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="{DynamicResource Text.Update.Available}"
                                       FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource TahoeTextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border CornerRadius="10" Background="{StaticResource TahoeAccentBrush}"
                                    Padding="8,2">
                                <TextBlock Text="{Binding TagName}" FontSize="12" Foreground="White" />
                            </Border>
                        </StackPanel>

                        <!-- プログレスバー -->
                        <ProgressBar Minimum="0" Maximum="100"
                                     Value="{Binding #ThisWindow.DataContext.DownloadProgress}"
                                     IsVisible="{Binding #ThisWindow.DataContext.IsDownloading}"
                                     Height="6" />

                        <!-- ボタン -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <Button Classes="tahoe-primary"
                                    Click="OnDownloadAndInstall"
                                    IsVisible="{Binding !#ThisWindow.DataContext.IsDownloading}">
                                <TextBlock Text="{DynamicResource Text.Update.DownloadInstall}" />
                            </Button>
                            <Button Classes="tahoe-secondary"
                                    Click="OnIgnoreVersion"
                                    IsVisible="{Binding !#ThisWindow.DataContext.IsDownloading}">
                                <TextBlock Text="{DynamicResource Text.Update.IgnoreVersion}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>

                <!-- === 最新版 === -->
                <DataTemplate DataType="m:AlreadyUpToDate">
                    <StackPanel Spacing="12" Margin="0,8">
                        <TextBlock Text="{DynamicResource Text.Update.UpToDate}"
                                   FontSize="14"
                                   Foreground="{StaticResource TahoeTextPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <Button Classes="tahoe-primary"
                                Click="OnClose"
                                Content="{DynamicResource Text.Close}"
                                HorizontalAlignment="Center"
                                Padding="24,6" />
                    </StackPanel>
                </DataTemplate>

                <!-- === エラー === -->
                <DataTemplate DataType="m:SelfUpdateFailed">
                    <StackPanel Spacing="8" Margin="0,8">
                        <TextBlock Text="{DynamicResource Text.Update.CheckFailed}"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="{StaticResource TahoeRedBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Reason}"
                                   Classes="caption"
                                   TextWrapping="Wrap"
                                   MaxWidth="360"
                                   HorizontalAlignment="Center" />
                        <Button Classes="tahoe-primary"
                                Click="OnClose"
                                Content="{DynamicResource Text.Close}"
                                HorizontalAlignment="Center"
                                Padding="24,6" />
                    </StackPanel>
                </DataTemplate>

            </ContentControl.DataTemplates>
        </ContentControl>

    </Panel>

</Window>
