<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Ferry.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="700"
             x:Class="Ferry.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <!-- 余白は ScrollViewer の Padding ではなく内側 StackPanel の Margin で取る (Lhamiel 設定タブと同じパターン)。
         Avalonia の ScrollViewer は Padding 下端をスクロール extent に含めないため、Padding 指定だと
         最後の要素 (アップデート確認 / スキップ取消ボタン) がスクロールしきっても見切れる。
         Margin にすると余白ごとスクロール可能になり、最下部まで確実に表示できる。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4" MaxWidth="500" Margin="24,16,24,32">

            <!-- 一般 -->
            <TextBlock Classes="sectionHeader" Text="{DynamicResource Text.Settings.General}" />
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,4">
                <StackPanel Spacing="8">
                    <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.DisplayName}" />
                    <TextBox Text="{Binding DisplayName, Mode=TwoWay}"
                             PlaceholderText="{DynamicResource Text.Settings.DisplayName.Placeholder}"
                             Classes="search" />
                </StackPanel>
            </Border>

            <!-- 外観 -->
            <TextBlock Classes="sectionHeader" Text="{DynamicResource Text.Settings.Appearance}" />
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,4">
                <StackPanel Spacing="12">
                    <!-- テーマ。各 ComboBoxItem.Content は DynamicResource で直接引くため、
                         言語切替で MergedDictionaries 差し替えが起きても ItemsSource は触らず、
                         SelectedIndex がリセットされない (旧 ItemsSource={Binding ThemeOptions} 方式は
                         Replace でも Avalonia ComboBox 内部の SelectedItem 状態が外れていた)。 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.Theme}" />
                        <ComboBox Grid.Column="1"
                                  SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}"
                                  MinWidth="120">
                            <ComboBoxItem Content="{DynamicResource Text.Settings.Theme.System}" />
                            <ComboBoxItem Content="{DynamicResource Text.Settings.Theme.Light}" />
                            <ComboBoxItem Content="{DynamicResource Text.Settings.Theme.Dark}" />
                        </ComboBox>
                    </Grid>

                    <!-- 言語 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.Language}" />
                        <ComboBox Grid.Column="1" x:Name="LocaleComboBox"
                                  MinWidth="160" />
                    </Grid>

                    <!-- N-1: AccentColor / FontSize は未実装で死蔵だったため削除（ThemeMode のみ有効） -->
                </StackPanel>
            </Border>

            <!-- ファイル -->
            <TextBlock Classes="sectionHeader" Text="{DynamicResource Text.Settings.File}" />
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,4">
                <StackPanel Spacing="12">
                    <!-- 受信ファイルの保存先 (ラベル + readonly TextBox + 「変更」ボタン)。
                         「保存先を開く」アクションは転送タブのヘッダー（ファイル送信ボタンの隣）に集約済み。 -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.SaveDirectory}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Classes="search" IsReadOnly="True"
                                     VerticalAlignment="Center"
                                     Text="{Binding SaveDirectory}"
                                     ToolTip.Tip="{Binding SaveDirectory}" />
                            <Button Grid.Column="1" Margin="6,0,0,0"
                                    Content="{DynamicResource Text.Settings.SaveDirectory.Browse}"
                                    Command="{Binding BrowseSaveDirectoryCommand}" />
                        </Grid>
                    </StackPanel>

                    <!-- ファイル自動承認 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.AutoAcceptFile}" />
                            <TextBlock Classes="settingDescription" Text="{DynamicResource Text.Settings.AutoAcceptFile.Desc}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoAcceptFileTransfer, Mode=TwoWay}" />
                    </Grid>

                    <!-- アップロード帯域制限 (KB/s)。0 で無制限。 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.UploadKBps}" />
                            <TextBlock Classes="settingDescription" Text="{DynamicResource Text.Settings.UploadKBps.Desc}" />
                        </StackPanel>
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding UploadKBps, Mode=TwoWay}"
                                       Minimum="0" Maximum="1048576" Increment="128"
                                       FormatString="0"
                                       MinWidth="140" />
                    </Grid>

                    <!-- ダウンロード帯域制限 (KB/s)。0 で無制限。 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.DownloadKBps}" />
                            <TextBlock Classes="settingDescription" Text="{DynamicResource Text.Settings.DownloadKBps.Desc}" />
                        </StackPanel>
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding DownloadKBps, Mode=TwoWay}"
                                       Minimum="0" Maximum="1048576" Increment="128"
                                       FormatString="0"
                                       MinWidth="140" />
                    </Grid>

                    <!-- 同時並列転送数。複数ファイル選択時の同時送信本数 (1〜8)。 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.ParallelTransfer}" />
                            <TextBlock Classes="settingDescription" Text="{DynamicResource Text.Settings.ParallelTransfer.Desc}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ParallelTransferOptions}"
                                  SelectedItem="{Binding ParallelTransferCount, Mode=TwoWay}"
                                  MinWidth="120" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 動作 -->
            <TextBlock Classes="sectionHeader" Text="{DynamicResource Text.Settings.Behavior}" />
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,4">
                <StackPanel Spacing="12">
                    <!-- Windows 自動起動 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.AutoStartWithWindows}" />
                            <TextBlock Classes="settingDescription" Text="{DynamicResource Text.Settings.AutoStartWithWindows.Desc}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoStartWithWindows, Mode=TwoWay}" />
                    </Grid>

                    <!-- N-2: 旧スタートアップ起動は AutoStartWithWindows と意味が重複していたため削除 -->

                    <!-- 最小化起動 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.StartMinimized}" />
                            <TextBlock Classes="settingDescription" Text="{DynamicResource Text.Settings.StartMinimized.Desc}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                    </Grid>

                    <!-- トレイ最小化 (macOS は最小化=Dock 格納が OS 慣習で no-op のため行ごと非表示。
                         「タスクトレイ」表現が mac で通じない問題もこれで回避する。) -->
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsTrayMinimizeSupported}">
                        <StackPanel>
                            <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.MinimizeToTray}" />
                            <TextBlock Classes="settingDescription" Text="{DynamicResource Text.Settings.MinimizeToTray.Desc}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 通知 -->
            <TextBlock Classes="sectionHeader" Text="{DynamicResource Text.Settings.Notification}" />
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,4">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.NotificationSound}" />
                        <TextBlock Classes="settingDescription" Text="{DynamicResource Text.Settings.NotificationSound.Desc}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableNotificationSound, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- バージョン (Lhamiel 同等パターン: 表示 + 更新確認ボタン (IsCheckingUpdate で無効化)
                 + スキップ中バージョン表示 + スキップ取り消しボタン) -->
            <TextBlock Classes="sectionHeader" Text="{DynamicResource Text.Settings.Version}" />
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <!-- 行 0: バージョン表示 + 更新確認ボタン -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{Binding VersionText}"
                               FontSize="14" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Grid.Row="0" Grid.Column="1" Classes="accent"
                            Content="{DynamicResource Text.Settings.CheckUpdate}"
                            Command="{Binding CheckForUpdateCommand}"
                            IsEnabled="{Binding !IsCheckingUpdate}" />

                    <!-- 行 1: スキップ中バージョンの案内 + 取り消しボタン (スキップが設定されている時のみ表示) -->
                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                          Margin="0,10,0,0"
                          ColumnDefinitions="*,Auto"
                          IsVisible="{Binding HasIgnoredUpdateTag}">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding IgnoredUpdateTagDisplay}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1" Margin="8,0,0,0"
                                Content="{DynamicResource Text.Settings.Version.ClearSkippedVersion}"
                                Command="{Binding ClearIgnoredUpdateTagCommand}"
                                FontSize="12" />
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
