<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Ferry.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="700"
             x:Class="Ferry.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <!-- Padding の bottom を 32 に増やして、最後の「アップデート確認」ボタンが
         ウィンドウ最下部で見切れないよう余裕を持たせる -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,32">
        <StackPanel Spacing="4" MaxWidth="500">

            <!-- 一般 -->
            <TextBlock Classes="sectionHeader" Text="{DynamicResource Text.Settings.General}" />
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,4">
                <StackPanel Spacing="8">
                    <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.DisplayName}" />
                    <TextBox Text="{Binding DisplayName, Mode=TwoWay}"
                             PlaceholderText="{DynamicResource Text.Settings.DisplayName.Placeholder}"
                             Classes="search" />
                </StackPanel>
            </Border>

            <!-- 外観 -->
            <TextBlock Classes="sectionHeader" Text="{DynamicResource Text.Settings.Appearance}" />
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,4">
                <StackPanel Spacing="12">
                    <!-- テーマ -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.Theme}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}"
                                  SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}"
                                  MinWidth="120" />
                    </Grid>

                    <!-- 言語 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.Language}" />
                        <ComboBox Grid.Column="1" x:Name="LocaleComboBox"
                                  MinWidth="160" />
                    </Grid>

                    <!-- N-1: AccentColor / FontSize は未実装で死蔵だったため削除（ThemeMode のみ有効） -->
                </StackPanel>
            </Border>

            <!-- ファイル -->
            <TextBlock Classes="sectionHeader" Text="{DynamicResource Text.Settings.File}" />
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,4">
                <StackPanel Spacing="12">
                    <!-- 保存先ディレクトリ -->
                    <StackPanel Spacing="4">
                        <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.SaveDirectory}" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBox Grid.Column="0" Text="{Binding SaveDirectory, Mode=TwoWay}"
                                     Classes="search" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="{DynamicResource Text.Settings.SaveDirectory.Browse}"
                                    Classes="accent" Margin="8,0,0,0"
                                    Command="{Binding BrowseSaveDirectoryCommand}" />
                        </Grid>
                    </StackPanel>

                    <!-- v1.0.38: ReceiveFileSavePath は SaveDirectory と重複していたため UI から撤去 -->

                    <!-- ファイル自動承認 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.AutoAcceptFile}" />
                            <TextBlock Classes="settingDescription" Text="{DynamicResource Text.Settings.AutoAcceptFile.Desc}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoAcceptFileTransfer, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 動作 -->
            <TextBlock Classes="sectionHeader" Text="{DynamicResource Text.Settings.Behavior}" />
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,4">
                <StackPanel Spacing="12">
                    <!-- Windows 自動起動 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.AutoStartWithWindows}" />
                            <TextBlock Classes="settingDescription" Text="{DynamicResource Text.Settings.AutoStartWithWindows.Desc}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoStartWithWindows, Mode=TwoWay}" />
                    </Grid>

                    <!-- N-2: 旧スタートアップ起動は AutoStartWithWindows と意味が重複していたため削除 -->

                    <!-- 最小化起動 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.StartMinimized}" />
                            <TextBlock Classes="settingDescription" Text="{DynamicResource Text.Settings.StartMinimized.Desc}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                    </Grid>

                    <!-- トレイ最小化 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.MinimizeToTray}" />
                            <TextBlock Classes="settingDescription" Text="{DynamicResource Text.Settings.MinimizeToTray.Desc}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 通知 -->
            <TextBlock Classes="sectionHeader" Text="{DynamicResource Text.Settings.Notification}" />
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,4">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Classes="settingLabel" Text="{DynamicResource Text.Settings.NotificationSound}" />
                        <TextBlock Classes="settingDescription" Text="{DynamicResource Text.Settings.NotificationSound.Desc}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableNotificationSound, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- バージョン (v1.0.38: VersionText が "Ferry v1.0.xx" 形式で確実に表示される) -->
            <TextBlock Classes="sectionHeader" Text="{DynamicResource Text.Settings.Version}" />
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               Text="{Binding VersionText}"
                               FontSize="14" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="accent"
                            Content="{DynamicResource Text.Settings.CheckUpdate}"
                            Command="{Binding CheckForUpdateCommand}" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
