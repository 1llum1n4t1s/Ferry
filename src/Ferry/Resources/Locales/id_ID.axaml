<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Ferry/Resources/Locales/en_US.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Tabs -->
  <x:String x:Key="Text.Tab.Members" xml:space="preserve">👥 Anggota</x:String>
  <x:String x:Key="Text.Tab.AddMember" xml:space="preserve">➕ Tambah Anggota</x:String>
  <x:String x:Key="Text.Tab.Transfer" xml:space="preserve">📁 Transfer</x:String>
  <x:String x:Key="Text.Tab.Settings" xml:space="preserve">⚙️ Pengaturan</x:String>

  <!-- Drop Overlay -->
  <x:String x:Key="Text.Drop.Message" xml:space="preserve">Lepaskan file untuk mentransfer</x:String>
  <x:String x:Key="Text.Drop.Description" xml:space="preserve">File yang dilepaskan akan dikirim ke perangkat yang terhubung</x:String>

  <!-- Connection Panel -->
  <x:String x:Key="Text.Connection.Header" xml:space="preserve">Tujuan</x:String>
  <x:String x:Key="Text.Connection.PairingLink" xml:space="preserve">Atau bagikan tautan pemasangan.</x:String>
  <x:String x:Key="Text.Connection.Copy" xml:space="preserve">Salin</x:String>
  <x:String x:Key="Text.Connection.Copied" xml:space="preserve">Tersalin</x:String>
  <x:String x:Key="Text.Connection.Start" xml:space="preserve">Mulai Koneksi</x:String>
  <x:String x:Key="Text.Connection.Cancel" xml:space="preserve">Batal</x:String>
  <x:String x:Key="Text.Connection.AddDevice" xml:space="preserve">Tambah Perangkat Baru</x:String>
  <x:String x:Key="Text.Connection.RemovePeer" xml:space="preserve">Hapus Pemasangan</x:String>
  <x:String x:Key="Text.Connection.Leave" xml:space="preserve">Tinggalkan Jaringan</x:String>

  <!-- Transfer Panel -->
  <x:String x:Key="Text.Transfer.Header" xml:space="preserve">Riwayat Transfer</x:String>
  <x:String x:Key="Text.Transfer.Clear" xml:space="preserve">Hapus</x:String>
  <x:String x:Key="Text.Transfer.DropHint" xml:space="preserve">Lepaskan file untuk mentransfer</x:String>
  <x:String x:Key="Text.Transfer.Approve" xml:space="preserve">Setujui</x:String>
  <x:String x:Key="Text.Transfer.Reject" xml:space="preserve">Tolak</x:String>
  <x:String x:Key="Text.Transfer.OpenFolder" xml:space="preserve">Buka folder</x:String>

  <!-- Settings Panel -->
  <x:String x:Key="Text.Settings.General" xml:space="preserve">Umum</x:String>
  <x:String x:Key="Text.Settings.DisplayName" xml:space="preserve">Nama yang Ditampilkan ke Lawan</x:String>
  <x:String x:Key="Text.Settings.DisplayName.Placeholder" xml:space="preserve">Masukkan nama PC</x:String>
  <x:String x:Key="Text.Settings.Appearance" xml:space="preserve">Tampilan</x:String>
  <x:String x:Key="Text.Settings.Theme" xml:space="preserve">Tema</x:String>
  <x:String x:Key="Text.Settings.Theme.System" xml:space="preserve">Sistem (Ikuti OS)</x:String>
  <x:String x:Key="Text.Settings.Theme.Light" xml:space="preserve">Terang</x:String>
  <x:String x:Key="Text.Settings.Theme.Dark" xml:space="preserve">Gelap</x:String>
  <x:String x:Key="Text.Settings.Language" xml:space="preserve">Bahasa</x:String>
  <x:String x:Key="Text.Settings.File" xml:space="preserve">File</x:String>
  <x:String x:Key="Text.Settings.SaveDirectory" xml:space="preserve">Lokasi penyimpanan file yang diterima</x:String>
  <x:String x:Key="Text.Settings.SaveDirectory.Browse" xml:space="preserve">Jelajahi</x:String>
  <x:String x:Key="Text.Settings.Behavior" xml:space="preserve">Perilaku</x:String>
  <x:String x:Key="Text.Settings.StartMinimized" xml:space="preserve">Mulai diminimalkan</x:String>
  <x:String x:Key="Text.Settings.StartMinimized.Desc" xml:space="preserve">Diluncurkan di latar belakang</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray" xml:space="preserve">Minimalkan ke tray saat ditutup</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray.Desc" xml:space="preserve">Tombol tutup mengirim ke system tray</x:String>
  <x:String x:Key="Text.Settings.Version" xml:space="preserve">Versi</x:String>
  <x:String x:Key="Text.Settings.CheckUpdate" xml:space="preserve">Periksa Pembaruan</x:String>
  <x:String x:Key="Text.Settings.Version.SkippedVersion" xml:space="preserve">Skipping version {0}</x:String>
  <x:String x:Key="Text.Settings.Version.ClearSkippedVersion" xml:space="preserve">Undo</x:String>

  <!-- Transfer States -->
  <x:String x:Key="Text.State.Pending" xml:space="preserve">Menunggu...</x:String>
  <x:String x:Key="Text.State.Sending" xml:space="preserve">Mengirim</x:String>
  <x:String x:Key="Text.State.Receiving" xml:space="preserve">Menerima</x:String>
  <x:String x:Key="Text.State.Completed" xml:space="preserve">Selesai</x:String>
  <x:String x:Key="Text.State.Error" xml:space="preserve">Kesalahan</x:String>
  <x:String x:Key="Text.State.Cancelled" xml:space="preserve">Dibatalkan</x:String>
  <x:String x:Key="Text.State.Suspended" xml:space="preserve">Ditangguhkan</x:String>
  <x:String x:Key="Text.State.WaitingApproval" xml:space="preserve">Menunggu Persetujuan</x:String>

  <!-- Connection Status -->
  <x:String x:Key="Text.Status.Starting" xml:space="preserve">Memulai sesi...</x:String>
  <x:String x:Key="Text.Status.ScanQR" xml:space="preserve">Pindai kode QR dengan smartphone Anda</x:String>
  <x:String x:Key="Text.Status.ScanPeerQR" xml:space="preserve">Pindai kode QR PC lainnya...</x:String>
  <x:String x:Key="Text.Status.Error" xml:space="preserve">Kesalahan: {0}</x:String>
  <x:String x:Key="Text.Status.Connected" xml:space="preserve">Terhubung</x:String>
  <x:String x:Key="Text.Status.Connecting" xml:space="preserve">Menghubungkan...</x:String>
  <x:String x:Key="Text.Status.Reconnecting" xml:space="preserve">Menghubungkan ulang...</x:String>

  <!-- Connection Routes -->
  <x:String x:Key="Text.Route.Direct" xml:space="preserve">LAN Langsung</x:String>
  <x:String x:Key="Text.Route.Stun" xml:space="preserve">Internet P2P (STUN)</x:String>
  <x:String x:Key="Text.Route.Relay" xml:space="preserve">Relay Server (TURN)</x:String>

  <!-- Self-Update Messages (VelopackUpdateDialog.Avalonia 用、Komorebi と同キー命名) -->
  <x:String x:Key="Text.SelfUpdate.Available" xml:space="preserve">Versi baru dari perangkat lunak ini tersedia: </x:String>
  <x:String x:Key="Text.SelfUpdate.Checking" xml:space="preserve">Memeriksa pembaruan...</x:String>
  <x:String x:Key="Text.SelfUpdate.DownloadAndInstall" xml:space="preserve">Unduh &amp; Instal</x:String>
  <x:String x:Key="Text.SelfUpdate.Error" xml:space="preserve">Pemeriksaan pembaruan gagal!</x:String>
  <x:String x:Key="Text.SelfUpdate.IgnoreThisVersion" xml:space="preserve">Lewati Versi Ini</x:String>
  <x:String x:Key="Text.SelfUpdate.Title" xml:space="preserve">Pembaruan Perangkat Lunak</x:String>
  <x:String x:Key="Text.SelfUpdate.UpToDate" xml:space="preserve">Saat ini tidak ada pembaruan yang tersedia.</x:String>

  <!-- Transfer Messages -->
  <x:String x:Key="Text.Transfer.Rejected" xml:space="preserve">Transfer ditolak</x:String>
  <x:String x:Key="Text.Transfer.ResumeFailed" xml:space="preserve">Gagal melanjutkan</x:String>
  <x:String x:Key="Text.Transfer.Retrying" xml:space="preserve">Retrying ({0}/{1})…</x:String>
  <x:String x:Key="Text.Transfer.ConnectFailed" xml:space="preserve">Could not establish a connection</x:String>
  <x:String x:Key="Text.Transfer.SelectFiles" xml:space="preserve">Select files to transfer</x:String>
  <x:String x:Key="Text.Transfer.SearchPeer" xml:space="preserve">Search peers...</x:String>
  <x:String x:Key="Text.Transfer.SelectMember" xml:space="preserve">Select a member to transfer files</x:String>
  <x:String x:Key="Text.Transfer.SendFile" xml:space="preserve">Send File</x:String>
  <x:String x:Key="Text.Transfer.DropHere" xml:space="preserve">Drop files here to send</x:String>
  <x:String x:Key="Text.Transfer.OrClickSend" xml:space="preserve">or click "Send File" button</x:String>
  <x:String x:Key="Text.Transfer.Accept" xml:space="preserve">Accept</x:String>

  <!-- Connection Phase Status -->
  <x:String x:Key="Text.Status.Phase.TcpPreparing" xml:space="preserve">Menyiapkan listener TCP…</x:String>
  <x:String x:Key="Text.Status.Phase.TcpConnecting" xml:space="preserve">Mencoba TCP langsung…</x:String>
  <x:String x:Key="Text.Status.Phase.StunQuery" xml:space="preserve">Mengkueri server STUN…</x:String>
  <x:String x:Key="Text.Status.Phase.UdpHolePunch" xml:space="preserve">UDP hole punching…</x:String>
  <x:String x:Key="Text.Status.Phase.Relay" xml:space="preserve">Menghubungkan via relay…</x:String>

  <!-- Tray Menu -->
  <x:String x:Key="Text.Tray.ShowWindow" xml:space="preserve">Tampilkan Jendela</x:String>
  <x:String x:Key="Text.Tray.Exit" xml:space="preserve">Keluar</x:String>
  <x:String x:Key="Text.Pairing.LinkLabel">Tautan Pemasangan</x:String>

  <x:String x:Key="Text.Close" xml:space="preserve">Tutup</x:String>

  <!-- Connection: No Members -->
  <x:String x:Key="Text.Connection.NoMembers" xml:space="preserve">Belum ada perangkat yang dipasangkan</x:String>

  <!-- Transfer: Empty -->
  <x:String x:Key="Text.Transfer.Empty" xml:space="preserve">Tidak ada transfer</x:String>

  <!-- Settings: Notification -->
  <x:String x:Key="Text.Settings.Notification" xml:space="preserve">Notifikasi</x:String>
  <x:String x:Key="Text.Settings.NotificationSound" xml:space="preserve">Suara Notifikasi</x:String>
  <x:String x:Key="Text.Settings.NotificationSound.Desc" xml:space="preserve">Putar suara saat menerima pesan</x:String>

  <!-- Settings: File Transfer -->
  <x:String x:Key="Text.Settings.FileTransfer" xml:space="preserve">Transfer File</x:String>
  <x:String x:Key="Text.Settings.ReceiveFileSavePath" xml:space="preserve">Lokasi Penyimpanan File yang Diterima</x:String>
  <x:String x:Key="Text.Settings.ReceiveFileSavePath.Default" xml:space="preserve">(Folder Unduhan)</x:String>
  <x:String x:Key="Text.Settings.AutoAcceptFile" xml:space="preserve">Terima File Otomatis</x:String>
  <x:String x:Key="Text.Settings.AutoAcceptFile.Desc" xml:space="preserve">Secara otomatis menerima file yang masuk</x:String>

  <!-- Settings: Appearance (extended) -->

  <!-- Settings: Auto Start -->
  <x:String x:Key="Text.Settings.AutoStartWithWindows" xml:space="preserve">Mulai dengan Windows</x:String>
  <x:String x:Key="Text.Settings.AutoStartWithWindows.Desc" xml:space="preserve">Daftarkan ke startup Windows melalui registri</x:String>
  <!-- v1.0.48: 帯域制限と並列転送数（英語フォールバック） -->
  <x:String x:Key="Text.Settings.UploadKBps" xml:space="preserve">Upload Limit (KB/s)</x:String>
  <x:String x:Key="Text.Settings.UploadKBps.Desc" xml:space="preserve">Outbound bandwidth cap. 0 = unlimited</x:String>
  <x:String x:Key="Text.Settings.DownloadKBps" xml:space="preserve">Download Limit (KB/s)</x:String>
  <x:String x:Key="Text.Settings.DownloadKBps.Desc" xml:space="preserve">Inbound bandwidth cap. 0 = unlimited</x:String>
  <x:String x:Key="Text.Settings.ParallelTransfer" xml:space="preserve">Parallel Transfers</x:String>
  <x:String x:Key="Text.Settings.ParallelTransfer.Desc" xml:space="preserve">Number of files sent simultaneously (1 = legacy serial)</x:String>
</ResourceDictionary>
