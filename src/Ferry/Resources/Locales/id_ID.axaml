  <!-- Transfer Messages -->
  <x:String x:Key="Text.Transfer.Rejected" xml:space="preserve">Transfer ditolak</x:String>
  <x:String x:Key="Text.Transfer.ResumeFailed" xml:space="preserve">Gagal melanjutkan</x:String>

  <!-- Connection Phase Status -->
  <x:String x:Key="Text.Status.Phase.TcpPreparing" xml:space="preserve">Menyiapkan listener TCP…</x:String>
  <x:String x:Key="Text.Status.Phase.TcpConnecting" xml:space="preserve">Mencoba TCP langsung…</x:String>
  <x:String x:Key="Text.Status.Phase.StunQuery" xml:space="preserve">Mengkueri server STUN…</x:String>
