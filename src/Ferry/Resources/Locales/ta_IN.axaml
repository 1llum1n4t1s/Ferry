  <!-- Settings: File Transfer -->
  <x:String x:Key="Text.Settings.FileTransfer" xml:space="preserve">கோப்பு பரிமாற்றம்</x:String>
  <x:String x:Key="Text.Settings.ReceiveFileSavePath" xml:space="preserve">பெறப்பட்ட கோப்பு சேமிப்பு பாதை</x:String>
  <x:String x:Key="Text.Settings.ReceiveFileSavePath.Default" xml:space="preserve">(பதிவிறக்கங்கள் கோப்புறை)</x:String>
  <x:String x:Key="Text.Settings.AutoAcceptFile" xml:space="preserve">கோப்புகளைத் தானாக ஏற்கவும்</x:String>
  <x:String x:Key="Text.Settings.AutoAcceptFile.Desc" xml:space="preserve">வரும் கோப்புகளைத் தானாகவே ஏற்றுக்கொள்</x:String>

  <!-- Settings: Appearance (extended) -->

  <!-- Settings: Auto Start -->
  <x:String x:Key="Text.Settings.AutoStartWithWindows" xml:space="preserve">உள்நுழையும்போது தொடங்கு</x:String>
