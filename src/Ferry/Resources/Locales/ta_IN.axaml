  <x:String x:Key="Text.Route.Lan.Label" xml:space="preserve">நேரடி LAN</x:String>
  <x:String x:Key="Text.Route.Lan.Tooltip" xml:space="preserve">நேரடி LAN இணைப்பு (TCP) — வேகமானது, அதிக அலைவரிசை</x:String>
  <x:String x:Key="Text.Route.P2p.Badge" xml:space="preserve">P2P</x:String>
  <x:String x:Key="Text.Route.P2p.Label" xml:space="preserve">P2P (STUN)</x:String>
  <x:String x:Key="Text.Route.P2p.Tooltip" xml:space="preserve">நேரடி P2P இணைப்பு (UDP hole punching + STUN) — இணையம் வழியாக</x:String>
  <x:String x:Key="Text.Route.Relay.Badge" xml:space="preserve">RELAY</x:String>
  <x:String x:Key="Text.Route.Relay.Label" xml:space="preserve">ரிலே (TURN)</x:String>
  <x:String x:Key="Text.Route.Relay.Tooltip" xml:space="preserve">சேவையகம் வழியாக ரிலே (TURN/WebSocket) — ஃபயர்வால்களைக் கடக்கும்</x:String>
  <x:String x:Key="Text.Route.Unknown.Badge" xml:space="preserve">சரிபார்க்கிறது</x:String>
  <x:String x:Key="Text.Route.Unknown.Tooltip" xml:space="preserve">இணைப்புப் பாதை சரிபார்க்கப்படுகிறது…</x:String>
  <x:String x:Key="Text.SaveBar.Open" xml:space="preserve">சேமிப்புக் கோப்புறையைத் திற</x:String>
  <x:String x:Key="Text.SaveBar.Tooltip" xml:space="preserve">பெறப்பட்ட கோப்புகள் சேமிக்கப்படும் இடம்</x:String>
  <x:String x:Key="Text.Sidebar.AddPeer" xml:space="preserve">இணைப்பைச் சேர்</x:String>
  <x:String x:Key="Text.Sidebar.RefreshPeers" xml:space="preserve">சாதனப் பட்டியலைப் புதுப்பி</x:String>
  <x:String x:Key="Text.Sidebar.Settings" xml:space="preserve">அமைப்புகள்</x:String>
  <x:String x:Key="Text.State.Paused" xml:space="preserve">இடைநிறுத்தப்பட்டது</x:String>
  <x:String x:Key="Text.Transfer.Cancel" xml:space="preserve">ரத்துசெய்</x:String>
  <x:String x:Key="Text.Transfer.ClearHistory" xml:space="preserve">வரலாற்றை அழி</x:String>
  <x:String x:Key="Text.Transfer.Delete" xml:space="preserve">நீக்கு</x:String>
  <x:String x:Key="Text.Transfer.Pause" xml:space="preserve">இடைநிறுத்து</x:String>
  <x:String x:Key="Text.Transfer.PeerMissing" xml:space="preserve">இலக்குச் சாதனம் கிடைக்கவில்லை</x:String>
  <x:String x:Key="Text.Transfer.Resend" xml:space="preserve">மீண்டும் அனுப்பு</x:String>
  <x:String x:Key="Text.Transfer.Resume" xml:space="preserve">தொடர்</x:String>
  <x:String x:Key="Text.Transfer.ResumeSuspended" xml:space="preserve">தொடர்</x:String>
  <x:String x:Key="Text.Transfer.SourceMissing" xml:space="preserve">மூலக் கோப்பு கிடைக்கவில்லை</x:String>
  <x:String x:Key="Text.Tray.CheckForUpdate" xml:space="preserve">புதுப்பிப்புகளைச் சரிபார்…</x:String>
  <x:String x:Key="Text.Warn" xml:space="preserve">எச்சரிக்கை</x:String>

</ResourceDictionary>
