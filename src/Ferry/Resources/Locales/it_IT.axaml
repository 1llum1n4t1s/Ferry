<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Ferry/Resources/Locales/en_US.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Tabs -->
  <x:String x:Key="Text.Tab.Members" xml:space="preserve">👥 Membri</x:String>
  <x:String x:Key="Text.Tab.AddMember" xml:space="preserve">➕ Aggiungi membro</x:String>
  <x:String x:Key="Text.Tab.Transfer" xml:space="preserve">📁 Trasferimento</x:String>
  <x:String x:Key="Text.Tab.Settings" xml:space="preserve">⚙️ Impostazioni</x:String>

  <!-- Drop Overlay -->
  <x:String x:Key="Text.Drop.Message" xml:space="preserve">Rilascia i file per trasferirli</x:String>
  <x:String x:Key="Text.Drop.Description" xml:space="preserve">I file rilasciati verranno inviati al dispositivo connesso</x:String>

  <!-- Connection Panel -->
  <x:String x:Key="Text.Connection.Header" xml:space="preserve">Destinazione</x:String>
  <x:String x:Key="Text.Connection.PairingLink" xml:space="preserve">Oppure condividi il link di associazione.</x:String>
  <x:String x:Key="Text.Connection.Copy" xml:space="preserve">Copia</x:String>
  <x:String x:Key="Text.Connection.Copied" xml:space="preserve">Copiato</x:String>
  <x:String x:Key="Text.Connection.Start" xml:space="preserve">Avvia connessione</x:String>
  <x:String x:Key="Text.Connection.Cancel" xml:space="preserve">Annulla</x:String>
  <x:String x:Key="Text.Connection.AddDevice" xml:space="preserve">Aggiungi nuovo dispositivo</x:String>
  <x:String x:Key="Text.Connection.RemovePeer" xml:space="preserve">Rimuovi associazione</x:String>
  <x:String x:Key="Text.Connection.Leave" xml:space="preserve">Esci dalla rete</x:String>

  <!-- Transfer Panel -->
  <x:String x:Key="Text.Transfer.Header" xml:space="preserve">Cronologia trasferimenti</x:String>
  <x:String x:Key="Text.Transfer.Clear" xml:space="preserve">Cancella</x:String>
  <x:String x:Key="Text.Transfer.DropHint" xml:space="preserve">Rilascia i file per trasferirli</x:String>
  <x:String x:Key="Text.Transfer.Approve" xml:space="preserve">Approva</x:String>
  <x:String x:Key="Text.Transfer.Reject" xml:space="preserve">Rifiuta</x:String>
  <x:String x:Key="Text.Transfer.OpenFolder" xml:space="preserve">Apri cartella</x:String>

  <!-- Settings Panel -->
  <x:String x:Key="Text.Settings.General" xml:space="preserve">Generale</x:String>
  <x:String x:Key="Text.Settings.DisplayName" xml:space="preserve">Nome visibile agli altri</x:String>
  <x:String x:Key="Text.Settings.DisplayName.Placeholder" xml:space="preserve">Inserisci il nome del PC</x:String>
  <x:String x:Key="Text.Settings.Appearance" xml:space="preserve">Aspetto</x:String>
  <x:String x:Key="Text.Settings.Theme" xml:space="preserve">Tema</x:String>
  <x:String x:Key="Text.Settings.Theme.System" xml:space="preserve">Sistema (segui il SO)</x:String>
  <x:String x:Key="Text.Settings.Theme.Light" xml:space="preserve">Chiaro</x:String>
  <x:String x:Key="Text.Settings.Theme.Dark" xml:space="preserve">Scuro</x:String>
  <x:String x:Key="Text.Settings.Language" xml:space="preserve">Lingua</x:String>
  <x:String x:Key="Text.Settings.File" xml:space="preserve">File</x:String>
  <x:String x:Key="Text.Settings.SaveDirectory" xml:space="preserve">Posizione di salvataggio dei file ricevuti</x:String>
  <x:String x:Key="Text.Settings.SaveDirectory.Browse" xml:space="preserve">Sfoglia</x:String>
  <x:String x:Key="Text.Settings.Behavior" xml:space="preserve">Comportamento</x:String>
  <x:String x:Key="Text.Settings.RunAtStartup" xml:space="preserve">Apri Ferry all'avvio</x:String>
  <x:String x:Key="Text.Settings.RunAtStartup.Desc" xml:space="preserve">Si avvia automaticamente all'accensione del computer</x:String>
  <x:String x:Key="Text.Settings.StartMinimized" xml:space="preserve">Avvia ridotto a icona</x:String>
  <x:String x:Key="Text.Settings.StartMinimized.Desc" xml:space="preserve">Si avvia in background</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray" xml:space="preserve">Riduci nell'area di notifica alla chiusura</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray.Desc" xml:space="preserve">Il pulsante di chiusura riduce nell'area di notifica</x:String>
  <x:String x:Key="Text.Settings.Version" xml:space="preserve">Versione</x:String>
  <x:String x:Key="Text.Settings.CheckUpdate" xml:space="preserve">Controlla aggiornamenti</x:String>

  <!-- Transfer States -->
  <x:String x:Key="Text.State.Pending" xml:space="preserve">In attesa...</x:String>
  <x:String x:Key="Text.State.Sending" xml:space="preserve">Invio in corso</x:String>
  <x:String x:Key="Text.State.Receiving" xml:space="preserve">Ricezione in corso</x:String>
  <x:String x:Key="Text.State.Completed" xml:space="preserve">Completato</x:String>
  <x:String x:Key="Text.State.Error" xml:space="preserve">Errore</x:String>
  <x:String x:Key="Text.State.Cancelled" xml:space="preserve">Annullato</x:String>
  <x:String x:Key="Text.State.Suspended" xml:space="preserve">Sospeso</x:String>
  <x:String x:Key="Text.State.WaitingApproval" xml:space="preserve">In attesa di approvazione</x:String>

  <!-- Connection Status -->
  <x:String x:Key="Text.Status.Starting" xml:space="preserve">Avvio sessione...</x:String>
  <x:String x:Key="Text.Status.ScanQR" xml:space="preserve">Scansiona il codice QR con lo smartphone</x:String>
  <x:String x:Key="Text.Status.ScanPeerQR" xml:space="preserve">Scansiona il codice QR dell'altro PC...</x:String>
  <x:String x:Key="Text.Status.Error" xml:space="preserve">Errore: {0}</x:String>
  <x:String x:Key="Text.Status.Connected" xml:space="preserve">Connesso</x:String>
  <x:String x:Key="Text.Status.Connecting" xml:space="preserve">Connessione in corso...</x:String>
  <x:String x:Key="Text.Status.Reconnecting" xml:space="preserve">Riconnessione in corso...</x:String>

  <!-- Connection Routes -->
  <x:String x:Key="Text.Route.Direct" xml:space="preserve">LAN diretto</x:String>
  <x:String x:Key="Text.Route.Stun" xml:space="preserve">Internet P2P (STUN)</x:String>
  <x:String x:Key="Text.Route.Relay" xml:space="preserve">Relay del server (TURN)</x:String>

  <!-- Update Messages -->
  <x:String x:Key="Text.Update.Checking" xml:space="preserve">Controllo aggiornamenti...</x:String>
  <x:String x:Key="Text.Update.DevEnvironment" xml:space="preserve">Impossibile controllare gli aggiornamenti in ambiente di sviluppo</x:String>
  <x:String x:Key="Text.Update.Downloading" xml:space="preserve">Download v{0} in corso...</x:String>
  <x:String x:Key="Text.Update.Applying" xml:space="preserve">Applicazione aggiornamento... Riavvio</x:String>
  <x:String x:Key="Text.Update.UpToDate" xml:space="preserve">Aggiornato</x:String>
  <x:String x:Key="Text.Update.Error" xml:space="preserve">Controllo aggiornamenti fallito: {0}</x:String>
  <x:String x:Key="Text.Update.Unknown" xml:space="preserve">Sconosciuto</x:String>

  <!-- Transfer Messages -->
  <x:String x:Key="Text.Transfer.Rejected" xml:space="preserve">Trasferimento rifiutato</x:String>
  <x:String x:Key="Text.Transfer.ResumeFailed" xml:space="preserve">Ripresa fallita</x:String>

  <!-- Connection Phase Status -->
  <x:String x:Key="Text.Status.Phase.TcpPreparing" xml:space="preserve">Preparazione listener TCP…</x:String>
  <x:String x:Key="Text.Status.Phase.TcpConnecting" xml:space="preserve">Tentativo di connessione TCP diretta…</x:String>
  <x:String x:Key="Text.Status.Phase.StunQuery" xml:space="preserve">Interrogazione server STUN…</x:String>
  <x:String x:Key="Text.Status.Phase.UdpHolePunch" xml:space="preserve">UDP hole punching…</x:String>
  <x:String x:Key="Text.Status.Phase.Relay" xml:space="preserve">Connessione tramite relay…</x:String>

  <!-- Tray Menu -->
  <x:String x:Key="Text.Tray.ShowWindow" xml:space="preserve">Mostra finestra</x:String>
  <x:String x:Key="Text.Tray.Exit" xml:space="preserve">Esci</x:String>
  <x:String x:Key="Text.Chat.Placeholder">Scrivi un messaggio...</x:String>
  <x:String x:Key="Text.Chat.SelectMember">Seleziona un membro per avviare la chat</x:String>
  <x:String x:Key="Text.Chat.AttachFile">Seleziona i file da inviare</x:String>

  <!-- Settings: Chat Retention -->
  <x:String x:Key="Text.Settings.ChatRetention" xml:space="preserve">Conservazione della cronologia chat</x:String>
  <x:String x:Key="Text.Settings.ChatRetention.Days" xml:space="preserve"> giorni</x:String>
  <x:String x:Key="Text.Settings.ChatRetention.Unlimited" xml:space="preserve">Illimitato</x:String>

  <x:String x:Key="Text.Pairing.LinkLabel">Link di accoppiamento</x:String>

  <x:String x:Key="Text.Close" xml:space="preserve">Chiudi</x:String>

  <!-- Connection: No Members -->
  <x:String x:Key="Text.Connection.NoMembers" xml:space="preserve">Nessun dispositivo associato</x:String>

  <!-- Transfer: Empty -->
  <x:String x:Key="Text.Transfer.Empty" xml:space="preserve">Nessun trasferimento</x:String>

  <!-- Update -->
  <x:String x:Key="Text.Update.Available" xml:space="preserve">Aggiornamento disponibile</x:String>
  <x:String x:Key="Text.Update.CheckFailed" xml:space="preserve">Controllo aggiornamenti fallito</x:String>
  <x:String x:Key="Text.Update.DownloadInstall" xml:space="preserve">Scarica e installa</x:String>
  <x:String x:Key="Text.Update.IgnoreVersion" xml:space="preserve">Ignora questa versione</x:String>

  <!-- Settings: Notification -->
  <x:String x:Key="Text.Settings.Notification" xml:space="preserve">Notifiche</x:String>
  <x:String x:Key="Text.Settings.NotificationSound" xml:space="preserve">Suono di notifica</x:String>
  <x:String x:Key="Text.Settings.NotificationSound.Desc" xml:space="preserve">Riproduci un suono alla ricezione dei messaggi</x:String>

  <!-- Settings: File Transfer -->
  <x:String x:Key="Text.Settings.FileTransfer" xml:space="preserve">Trasferimento file</x:String>
  <x:String x:Key="Text.Settings.ReceiveFileSavePath" xml:space="preserve">Percorso di salvataggio dei file ricevuti</x:String>
  <x:String x:Key="Text.Settings.ReceiveFileSavePath.Default" xml:space="preserve">(Cartella Download)</x:String>
  <x:String x:Key="Text.Settings.AutoAcceptFile" xml:space="preserve">Accetta file automaticamente</x:String>
  <x:String x:Key="Text.Settings.AutoAcceptFile.Desc" xml:space="preserve">Accetta automaticamente i file in arrivo</x:String>

  <!-- Settings: Appearance (extended) -->
  <x:String x:Key="Text.Settings.AccentColor" xml:space="preserve">Colore di evidenziazione</x:String>
  <x:String x:Key="Text.Settings.FontSize" xml:space="preserve">Dimensione del carattere</x:String>
  <x:String x:Key="Text.Settings.FontSize.Small" xml:space="preserve">Piccolo</x:String>
  <x:String x:Key="Text.Settings.FontSize.Medium" xml:space="preserve">Medio</x:String>
  <x:String x:Key="Text.Settings.FontSize.Large" xml:space="preserve">Grande</x:String>

  <!-- Settings: Auto Start -->
  <x:String x:Key="Text.Settings.AutoStartWithWindows" xml:space="preserve">Avvia con Windows</x:String>
  <x:String x:Key="Text.Settings.AutoStartWithWindows.Desc" xml:space="preserve">Registra nell'avvio automatico di Windows tramite il registro</x:String>

</ResourceDictionary>
