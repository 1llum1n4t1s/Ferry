  <x:String x:Key="Text.Settings.File" xml:space="preserve">File</x:String>
  <x:String x:Key="Text.Settings.SaveDirectory" xml:space="preserve">Posizione di salvataggio dei file ricevuti</x:String>
  <x:String x:Key="Text.Settings.SaveDirectory.Browse" xml:space="preserve">Sfoglia</x:String>
  <x:String x:Key="Text.Settings.Behavior" xml:space="preserve">Comportamento</x:String>
  <x:String x:Key="Text.Settings.StartMinimized" xml:space="preserve">Avvia ridotto a icona</x:String>
  <x:String x:Key="Text.Settings.StartMinimized.Desc" xml:space="preserve">Si avvia in background</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray" xml:space="preserve">Riduci nell'area di notifica alla chiusura</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray.Desc" xml:space="preserve">Il pulsante di chiusura riduce nell'area di notifica</x:String>
