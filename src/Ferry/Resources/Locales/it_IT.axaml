  <x:String x:Key="Text.Status.Connected" xml:space="preserve">Connesso</x:String>
  <x:String x:Key="Text.Status.Connecting" xml:space="preserve">Connessione in corso...</x:String>
  <x:String x:Key="Text.Status.Reconnecting" xml:space="preserve">Riconnessione in corso...</x:String>

  <!-- Connection Routes -->
  <x:String x:Key="Text.Route.Direct" xml:space="preserve">LAN diretto</x:String>
  <x:String x:Key="Text.Route.Stun" xml:space="preserve">Internet P2P (STUN)</x:String>
  <x:String x:Key="Text.Route.Relay" xml:space="preserve">Relay del server (TURN)</x:String>

  <!-- Self-Update Messages (VelopackUpdateDialog.Avalonia 用、Komorebi と同キー命名) -->
  <x:String x:Key="Text.SelfUpdate.Available" xml:space="preserve">È disponibile una nuova versione del software:</x:String>
  <x:String x:Key="Text.SelfUpdate.Checking" xml:space="preserve">Verifica aggiornamenti in corso...</x:String>
  <x:String x:Key="Text.SelfUpdate.DownloadAndInstall" xml:space="preserve">Scarica e installa</x:String>
  <x:String x:Key="Text.SelfUpdate.Error" xml:space="preserve">Errore durante il controllo degli aggiornamenti!</x:String>
