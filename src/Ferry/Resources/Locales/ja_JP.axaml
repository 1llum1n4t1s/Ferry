  <!-- 転送エラーの UI 文言（Util.ErrorText.Describe が参照。rere #U11） -->
  <x:String x:Key="Text.Transfer.Error.Io" xml:space="preserve">ファイルの読み書きに失敗しました（容量不足・ロックの可能性）</x:String>
  <x:String x:Key="Text.Transfer.Error.Access" xml:space="preserve">ファイルへのアクセス権限がありません</x:String>
