  <!-- Member: メンバーリスト操作 -->
  <x:String x:Key="Text.Member.Menu" xml:space="preserve">メニュー</x:String>
  <x:String x:Key="Text.Member.Delete" xml:space="preserve">削除</x:String>
  <x:String x:Key="Text.Member.Delete.Confirm" xml:space="preserve">"{0}" をメンバーから削除しますか？
この操作は取り消せません。</x:String>

