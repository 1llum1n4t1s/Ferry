  <x:String x:Key="Text.Settings.DownloadKBps" xml:space="preserve">ダウンロード帯域制限 (KB/s)</x:String>
  <x:String x:Key="Text.Settings.DownloadKBps.Desc" xml:space="preserve">受信速度の上限。0 で無制限</x:String>
  <x:String x:Key="Text.Settings.ParallelTransfer" xml:space="preserve">同時並列転送数</x:String>
  <x:String x:Key="Text.Settings.ParallelTransfer.Desc" xml:space="preserve">複数ファイルを同時に送る本数 (1 で従来通り)</x:String>

  <!-- Settings: Appearance (extended) -->

  <!-- Settings: Auto Start -->
  <x:String x:Key="Text.Settings.AutoStartWithWindows" xml:space="preserve">Windows と同時に起動</x:String>
  <x:String x:Key="Text.Settings.AutoStartWithWindows.Desc" xml:space="preserve">Windows のスタートアップにレジストリ登録する</x:String>

  <!-- Common: 確認ダイアログ等の共通文言 -->
  <x:String x:Key="Text.Warn" xml:space="preserve">警告</x:String>
