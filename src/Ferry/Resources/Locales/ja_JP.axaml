  <!-- Route バッジ: 接続経路ごとのラベル / 短縮バッジ / ツールチップ -->
  <x:String x:Key="Text.Route.Lan.Label" xml:space="preserve">LAN 直接</x:String>
  <x:String x:Key="Text.Route.P2p.Label" xml:space="preserve">P2P（STUN）</x:String>
