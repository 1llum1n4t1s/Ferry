<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Ferry/Resources/Locales/en_US.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Tabs -->
  <x:String x:Key="Text.Tab.Members" xml:space="preserve">👥 Membros</x:String>
  <x:String x:Key="Text.Tab.AddMember" xml:space="preserve">➕ Adicionar membro</x:String>
  <x:String x:Key="Text.Tab.Transfer" xml:space="preserve">📁 Transferência</x:String>
  <x:String x:Key="Text.Tab.Settings" xml:space="preserve">⚙️ Configurações</x:String>

  <!-- Drop Overlay -->
  <x:String x:Key="Text.Drop.Message" xml:space="preserve">Solte os arquivos para transferir</x:String>
  <x:String x:Key="Text.Drop.Description" xml:space="preserve">Os arquivos soltos serão enviados ao dispositivo conectado</x:String>

  <!-- Connection Panel -->
  <x:String x:Key="Text.Connection.Header" xml:space="preserve">Destino</x:String>
  <x:String x:Key="Text.Connection.PairingLink" xml:space="preserve">Ou compartilhe o link de pareamento.</x:String>
  <x:String x:Key="Text.Connection.Copy" xml:space="preserve">Copiar</x:String>
  <x:String x:Key="Text.Connection.Copied" xml:space="preserve">Copiado</x:String>
  <x:String x:Key="Text.Connection.Start" xml:space="preserve">Iniciar conexão</x:String>
  <x:String x:Key="Text.Connection.Cancel" xml:space="preserve">Cancelar</x:String>
  <x:String x:Key="Text.Connection.AddDevice" xml:space="preserve">Adicionar novo dispositivo</x:String>
  <x:String x:Key="Text.Connection.RemovePeer" xml:space="preserve">Remover pareamento</x:String>
  <x:String x:Key="Text.Connection.Leave" xml:space="preserve">Sair da rede</x:String>

  <!-- Transfer Panel -->
  <x:String x:Key="Text.Transfer.Header" xml:space="preserve">Histórico de transferências</x:String>
  <x:String x:Key="Text.Transfer.Clear" xml:space="preserve">Limpar</x:String>
  <x:String x:Key="Text.Transfer.DropHint" xml:space="preserve">Solte os arquivos para transferir</x:String>
  <x:String x:Key="Text.Transfer.Approve" xml:space="preserve">Aprovar</x:String>
  <x:String x:Key="Text.Transfer.Reject" xml:space="preserve">Rejeitar</x:String>
  <x:String x:Key="Text.Transfer.OpenFolder" xml:space="preserve">Abrir pasta</x:String>

  <!-- Settings Panel -->
  <x:String x:Key="Text.Settings.General" xml:space="preserve">Geral</x:String>
  <x:String x:Key="Text.Settings.DisplayName" xml:space="preserve">Nome exibido para outros</x:String>
  <x:String x:Key="Text.Settings.DisplayName.Placeholder" xml:space="preserve">Digite o nome do PC</x:String>
  <x:String x:Key="Text.Settings.Appearance" xml:space="preserve">Aparência</x:String>
  <x:String x:Key="Text.Settings.Theme" xml:space="preserve">Tema</x:String>
  <x:String x:Key="Text.Settings.Theme.System" xml:space="preserve">Sistema (seguir o SO)</x:String>
  <x:String x:Key="Text.Settings.Theme.Light" xml:space="preserve">Claro</x:String>
  <x:String x:Key="Text.Settings.Theme.Dark" xml:space="preserve">Escuro</x:String>
  <x:String x:Key="Text.Settings.Language" xml:space="preserve">Idioma</x:String>
  <x:String x:Key="Text.Settings.File" xml:space="preserve">Arquivo</x:String>
  <x:String x:Key="Text.Settings.SaveDirectory" xml:space="preserve">Local de salvamento dos arquivos recebidos</x:String>
  <x:String x:Key="Text.Settings.SaveDirectory.Browse" xml:space="preserve">Procurar</x:String>
  <x:String x:Key="Text.Settings.Behavior" xml:space="preserve">Comportamento</x:String>
  <x:String x:Key="Text.Settings.StartMinimized" xml:space="preserve">Iniciar minimizado</x:String>
  <x:String x:Key="Text.Settings.StartMinimized.Desc" xml:space="preserve">Inicia em segundo plano</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray" xml:space="preserve">Minimizar para a bandeja ao fechar</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray.Desc" xml:space="preserve">O botão fechar envia para a bandeja do sistema</x:String>
  <x:String x:Key="Text.Settings.Version" xml:space="preserve">Versão</x:String>
  <x:String x:Key="Text.Settings.CheckUpdate" xml:space="preserve">Verificar atualizações</x:String>

  <!-- Transfer States -->
  <x:String x:Key="Text.State.Pending" xml:space="preserve">Pendente...</x:String>
  <x:String x:Key="Text.State.Sending" xml:space="preserve">Enviando</x:String>
  <x:String x:Key="Text.State.Receiving" xml:space="preserve">Recebendo</x:String>
  <x:String x:Key="Text.State.Completed" xml:space="preserve">Concluído</x:String>
  <x:String x:Key="Text.State.Error" xml:space="preserve">Erro</x:String>
  <x:String x:Key="Text.State.Cancelled" xml:space="preserve">Cancelado</x:String>
  <x:String x:Key="Text.State.Suspended" xml:space="preserve">Suspenso</x:String>
  <x:String x:Key="Text.State.WaitingApproval" xml:space="preserve">Aguardando aprovação</x:String>

  <!-- Connection Status -->
  <x:String x:Key="Text.Status.Starting" xml:space="preserve">Iniciando sessão...</x:String>
  <x:String x:Key="Text.Status.ScanQR" xml:space="preserve">Escaneie o código QR com seu smartphone</x:String>
  <x:String x:Key="Text.Status.ScanPeerQR" xml:space="preserve">Escaneie o código QR do outro PC...</x:String>
  <x:String x:Key="Text.Status.Error" xml:space="preserve">Erro: {0}</x:String>
  <x:String x:Key="Text.Status.Connected" xml:space="preserve">Conectado</x:String>
  <x:String x:Key="Text.Status.Connecting" xml:space="preserve">Conectando...</x:String>
  <x:String x:Key="Text.Status.Reconnecting" xml:space="preserve">Reconectando...</x:String>

  <!-- Connection Routes -->
  <x:String x:Key="Text.Route.Direct" xml:space="preserve">LAN direto</x:String>
  <x:String x:Key="Text.Route.Stun" xml:space="preserve">Internet P2P (STUN)</x:String>
  <x:String x:Key="Text.Route.Relay" xml:space="preserve">Relay do servidor (TURN)</x:String>

  <!-- Self-Update Messages (VelopackUpdateDialog.Avalonia 用、Komorebi と同キー命名) -->
  <x:String x:Key="Text.SelfUpdate.Available" xml:space="preserve">Nova versão deste software disponível: </x:String>
  <x:String x:Key="Text.SelfUpdate.Checking" xml:space="preserve">Verificando atualizacoes...</x:String>
  <x:String x:Key="Text.SelfUpdate.DownloadAndInstall" xml:space="preserve">Baixar e instalar</x:String>
  <x:String x:Key="Text.SelfUpdate.Error" xml:space="preserve">Falha ao verificar atualizações!</x:String>
  <x:String x:Key="Text.SelfUpdate.IgnoreThisVersion" xml:space="preserve">Ignorar esta versão</x:String>
  <x:String x:Key="Text.SelfUpdate.Title" xml:space="preserve">Atualização de Software</x:String>
  <x:String x:Key="Text.SelfUpdate.UpToDate" xml:space="preserve">Não há atualizações disponíveis no momento.</x:String>

  <!-- Transfer Messages -->
  <x:String x:Key="Text.Transfer.Rejected" xml:space="preserve">Transferência rejeitada</x:String>
  <x:String x:Key="Text.Transfer.ResumeFailed" xml:space="preserve">Falha ao retomar</x:String>
  <x:String x:Key="Text.Transfer.SelectFiles" xml:space="preserve">Select files to transfer</x:String>
  <x:String x:Key="Text.Transfer.SearchPeer" xml:space="preserve">Search peers...</x:String>
  <x:String x:Key="Text.Transfer.SelectMember" xml:space="preserve">Select a member to transfer files</x:String>
  <x:String x:Key="Text.Transfer.SendFile" xml:space="preserve">Send File</x:String>
  <x:String x:Key="Text.Transfer.DropHere" xml:space="preserve">Drop files here to send</x:String>
  <x:String x:Key="Text.Transfer.OrClickSend" xml:space="preserve">or click "Send File" button</x:String>
  <x:String x:Key="Text.Transfer.Accept" xml:space="preserve">Accept</x:String>

  <!-- Connection Phase Status -->
  <x:String x:Key="Text.Status.Phase.TcpPreparing" xml:space="preserve">Preparando listener TCP…</x:String>
  <x:String x:Key="Text.Status.Phase.TcpConnecting" xml:space="preserve">Tentando TCP direto…</x:String>
  <x:String x:Key="Text.Status.Phase.StunQuery" xml:space="preserve">Consultando servidor STUN…</x:String>
  <x:String x:Key="Text.Status.Phase.UdpHolePunch" xml:space="preserve">UDP hole punching…</x:String>
  <x:String x:Key="Text.Status.Phase.Relay" xml:space="preserve">Conectando via relay…</x:String>

  <!-- Tray Menu -->
  <x:String x:Key="Text.Tray.ShowWindow" xml:space="preserve">Mostrar janela</x:String>
  <x:String x:Key="Text.Tray.Exit" xml:space="preserve">Sair</x:String>
  <x:String x:Key="Text.Pairing.LinkLabel">Link de pareamento</x:String>

  <x:String x:Key="Text.Close" xml:space="preserve">Fechar</x:String>

  <!-- Connection: No Members -->
  <x:String x:Key="Text.Connection.NoMembers" xml:space="preserve">Nenhum dispositivo pareado ainda</x:String>

  <!-- Transfer: Empty -->
  <x:String x:Key="Text.Transfer.Empty" xml:space="preserve">Nenhuma transferência</x:String>

  <!-- Settings: Notification -->
  <x:String x:Key="Text.Settings.Notification" xml:space="preserve">Notificações</x:String>
  <x:String x:Key="Text.Settings.NotificationSound" xml:space="preserve">Som de notificação</x:String>
  <x:String x:Key="Text.Settings.NotificationSound.Desc" xml:space="preserve">Reproduzir som ao receber mensagens</x:String>

  <!-- Settings: File Transfer -->
  <x:String x:Key="Text.Settings.FileTransfer" xml:space="preserve">Transferência de arquivos</x:String>
  <x:String x:Key="Text.Settings.ReceiveFileSavePath" xml:space="preserve">Caminho de salvamento dos arquivos recebidos</x:String>
  <x:String x:Key="Text.Settings.ReceiveFileSavePath.Default" xml:space="preserve">(Pasta de Downloads)</x:String>
  <x:String x:Key="Text.Settings.AutoAcceptFile" xml:space="preserve">Aceitar arquivos automaticamente</x:String>
  <x:String x:Key="Text.Settings.AutoAcceptFile.Desc" xml:space="preserve">Aceitar automaticamente os arquivos recebidos</x:String>

  <!-- Settings: Appearance (extended) -->

  <!-- Settings: Auto Start -->
  <x:String x:Key="Text.Settings.AutoStartWithWindows" xml:space="preserve">Iniciar com o Windows</x:String>
  <x:String x:Key="Text.Settings.AutoStartWithWindows.Desc" xml:space="preserve">Registrar na inicialização do Windows pelo registro</x:String>

</ResourceDictionary>
