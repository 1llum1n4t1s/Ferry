  <x:String x:Key="Text.Connection.NoMembers" xml:space="preserve">Нет сопряжённых устройств</x:String>

  <!-- Transfer: Empty -->
  <x:String x:Key="Text.Transfer.Empty" xml:space="preserve">Нет передач</x:String>

