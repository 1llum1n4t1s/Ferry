  <x:String x:Key="Text.SelfUpdate.DownloadAndInstall" xml:space="preserve">Скачать и установить</x:String>
  <x:String x:Key="Text.SelfUpdate.Error" xml:space="preserve">Не удалось проверить наличие обновлений!</x:String>
  <x:String x:Key="Text.SelfUpdate.IgnoreThisVersion" xml:space="preserve">Пропустить эту версию</x:String>
  <x:String x:Key="Text.SelfUpdate.Title" xml:space="preserve">Обновление ПО</x:String>
  <x:String x:Key="Text.SelfUpdate.UpToDate" xml:space="preserve">Сейчас нет обновлений.</x:String>

  <!-- Transfer Messages -->
  <x:String x:Key="Text.Transfer.Rejected" xml:space="preserve">Передача отклонена</x:String>
  <x:String x:Key="Text.Transfer.ResumeFailed" xml:space="preserve">Не удалось возобновить</x:String>
  <x:String x:Key="Text.Transfer.SelectFiles" xml:space="preserve">Select files to transfer</x:String>
  <x:String x:Key="Text.Transfer.SearchPeer" xml:space="preserve">Search peers...</x:String>
  <x:String x:Key="Text.Transfer.SelectMember" xml:space="preserve">Select a member to transfer files</x:String>
  <x:String x:Key="Text.Transfer.SendFile" xml:space="preserve">Send File</x:String>
  <x:String x:Key="Text.Transfer.DropHere" xml:space="preserve">Drop files here to send</x:String>
  <x:String x:Key="Text.Transfer.OrClickSend" xml:space="preserve">or click "Send File" button</x:String>
  <x:String x:Key="Text.Transfer.Accept" xml:space="preserve">Accept</x:String>

  <!-- Connection Phase Status -->
  <x:String x:Key="Text.Status.Phase.TcpPreparing" xml:space="preserve">Подготовка TCP-слушателя…</x:String>
  <x:String x:Key="Text.Status.Phase.TcpConnecting" xml:space="preserve">Попытка прямого TCP-соединения…</x:String>
  <x:String x:Key="Text.Status.Phase.StunQuery" xml:space="preserve">Запрос к STUN-серверу…</x:String>
