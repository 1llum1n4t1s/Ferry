  <x:String x:Key="Text.State.Pending" xml:space="preserve">Ожидание...</x:String>
  <x:String x:Key="Text.State.Sending" xml:space="preserve">Отправка</x:String>
  <x:String x:Key="Text.State.Receiving" xml:space="preserve">Получение</x:String>
  <x:String x:Key="Text.State.Completed" xml:space="preserve">Завершено</x:String>
  <x:String x:Key="Text.State.Error" xml:space="preserve">Ошибка</x:String>
  <x:String x:Key="Text.State.Cancelled" xml:space="preserve">Отменено</x:String>
