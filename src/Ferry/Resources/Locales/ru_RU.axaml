  <x:String x:Key="Text.State.WaitingApproval" xml:space="preserve">Ожидание подтверждения</x:String>

  <!-- Connection Status -->
  <x:String x:Key="Text.Status.Starting" xml:space="preserve">Запуск сессии...</x:String>
  <x:String x:Key="Text.Status.ScanQR" xml:space="preserve">Отсканируйте QR-код смартфоном</x:String>
  <x:String x:Key="Text.Status.ScanPeerQR" xml:space="preserve">Отсканируйте QR-код другого ПК...</x:String>
  <x:String x:Key="Text.Status.Error" xml:space="preserve">Ошибка: {0}</x:String>
  <x:String x:Key="Text.Status.Connected" xml:space="preserve">Подключено</x:String>
  <x:String x:Key="Text.Status.Connecting" xml:space="preserve">Подключение...</x:String>
  <x:String x:Key="Text.Status.Reconnecting" xml:space="preserve">Переподключение...</x:String>

  <!-- Connection Routes -->
  <x:String x:Key="Text.Route.Direct" xml:space="preserve">Прямое LAN-соединение</x:String>
