  <x:String x:Key="Text.Route.Relay" xml:space="preserve">Серверный ретранслятор (TURN)</x:String>

  <!-- Self-Update Messages (VelopackUpdateDialog.Avalonia 用、Komorebi と同キー命名) -->
  <x:String x:Key="Text.SelfUpdate.Available" xml:space="preserve">Доступна новая версия программного обеспечения: </x:String>
