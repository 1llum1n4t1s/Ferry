  <x:String x:Key="Text.Status.Connected" xml:space="preserve">संयुक्तम्</x:String>
  <x:String x:Key="Text.Status.Connecting" xml:space="preserve">संयोजयति...</x:String>
  <x:String x:Key="Text.Status.Reconnecting" xml:space="preserve">पुनः संयोजयति...</x:String>

