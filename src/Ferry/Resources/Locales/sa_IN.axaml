  <x:String x:Key="Text.Transfer.Accept" xml:space="preserve">Accept</x:String>

  <!-- Connection Phase Status -->
  <x:String x:Key="Text.Status.Phase.TcpPreparing" xml:space="preserve">TCP श्रोता सज्जीक्रियते…</x:String>
  <x:String x:Key="Text.Status.Phase.TcpConnecting" xml:space="preserve">TCP प्रत्यक्षसंयोजनं प्रयत्यते…</x:String>
  <x:String x:Key="Text.Status.Phase.StunQuery" xml:space="preserve">STUN सेवकं पृच्छति…</x:String>
  <x:String x:Key="Text.Status.Phase.UdpHolePunch" xml:space="preserve">UDP छिद्रभेदनम्…</x:String>
  <x:String x:Key="Text.Status.Phase.Relay" xml:space="preserve">रिले द्वारा संयोजयति…</x:String>

  <!-- Tray Menu -->
  <x:String x:Key="Text.Tray.ShowWindow" xml:space="preserve">वातायनं दर्शयतु</x:String>
  <x:String x:Key="Text.Tray.Exit" xml:space="preserve">निर्गमनम्</x:String>
  <x:String x:Key="Text.Pairing.LinkLabel">युग्मनसम्बन्धः</x:String>

  <x:String x:Key="Text.Close" xml:space="preserve">पिधत्ति</x:String>

  <!-- Connection: No Members -->
