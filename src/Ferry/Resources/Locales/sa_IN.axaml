<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Ferry/Resources/Locales/en_US.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Tabs -->
  <x:String x:Key="Text.Tab.Members" xml:space="preserve">👥 सदस्याः</x:String>
  <x:String x:Key="Text.Tab.AddMember" xml:space="preserve">➕ सदस्यं योजय</x:String>
  <x:String x:Key="Text.Tab.Transfer" xml:space="preserve">📁 स्थानान्तरणम्</x:String>
  <x:String x:Key="Text.Tab.Settings" xml:space="preserve">⚙️ विन्यासाः</x:String>

  <!-- Drop Overlay -->
  <x:String x:Key="Text.Drop.Message" xml:space="preserve">स्थानान्तरणाय सञ्चिकाः अत्र त्यजन्तु</x:String>
  <x:String x:Key="Text.Drop.Description" xml:space="preserve">त्यक्ताः सञ्चिकाः संयुक्तं यन्त्रं प्रति प्रेषयिष्यन्ते</x:String>

  <!-- Connection Panel -->
  <x:String x:Key="Text.Connection.Header" xml:space="preserve">गन्तव्यम्</x:String>
  <x:String x:Key="Text.Connection.PairingLink" xml:space="preserve">अथवा युग्मनसम्बन्धं विभजन्तु।</x:String>
  <x:String x:Key="Text.Connection.Copy" xml:space="preserve">प्रतिलिपिः</x:String>
  <x:String x:Key="Text.Connection.Copied" xml:space="preserve">प्रतिलिपिकृतम्</x:String>
  <x:String x:Key="Text.Connection.Start" xml:space="preserve">संयोजनम् आरभताम्</x:String>
  <x:String x:Key="Text.Connection.Cancel" xml:space="preserve">निरस्यताम्</x:String>
  <x:String x:Key="Text.Connection.AddDevice" xml:space="preserve">नवीनं यन्त्रं योजयतु</x:String>
  <x:String x:Key="Text.Connection.RemovePeer" xml:space="preserve">युग्मनं निवर्तयतु</x:String>
  <x:String x:Key="Text.Connection.Leave" xml:space="preserve">जालात् निर्गच्छतु</x:String>

