  <x:String x:Key="Text.State.Sending" xml:space="preserve">प्रेषयति</x:String>
  <x:String x:Key="Text.State.Receiving" xml:space="preserve">प्राप्नोति</x:String>
  <x:String x:Key="Text.State.Completed" xml:space="preserve">सम्पन्नम्</x:String>
  <x:String x:Key="Text.State.Error" xml:space="preserve">दोषः</x:String>
  <x:String x:Key="Text.State.Cancelled" xml:space="preserve">निरस्तम्</x:String>
  <x:String x:Key="Text.State.Suspended" xml:space="preserve">स्थगितम्</x:String>
  <x:String x:Key="Text.State.WaitingApproval" xml:space="preserve">अनुमोदनस्य प्रतीक्षा</x:String>

  <!-- Connection Status -->
  <x:String x:Key="Text.Status.Starting" xml:space="preserve">सत्रम् आरभते...</x:String>
  <x:String x:Key="Text.Status.ScanQR" xml:space="preserve">स्मार्टफोनेन QR सङ्केतं स्कैन् कुर्वन्तु</x:String>
