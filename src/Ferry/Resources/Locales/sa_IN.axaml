  <x:String x:Key="Text.Transfer.Header" xml:space="preserve">स्थानान्तरणस्य इतिहासः</x:String>
  <x:String x:Key="Text.Transfer.Clear" xml:space="preserve">शोधयतु</x:String>
  <x:String x:Key="Text.Transfer.DropHint" xml:space="preserve">स्थानान्तरणाय सञ्चिकाः अत्र त्यजन्तु</x:String>
  <x:String x:Key="Text.Transfer.Approve" xml:space="preserve">अनुमोदयतु</x:String>
  <x:String x:Key="Text.Transfer.Reject" xml:space="preserve">निराकरोतु</x:String>
  <x:String x:Key="Text.Transfer.OpenFolder" xml:space="preserve">सञ्चिकाकोशं उद्घाटयतु</x:String>

