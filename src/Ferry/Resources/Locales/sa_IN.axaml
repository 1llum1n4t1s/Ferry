  <x:String x:Key="Text.Settings.Language" xml:space="preserve">भाषा</x:String>
  <x:String x:Key="Text.Settings.File" xml:space="preserve">सञ्चिका</x:String>
  <x:String x:Key="Text.Settings.SaveDirectory" xml:space="preserve">प्राप्तसञ्चिकानां संरक्षणस्थानम्</x:String>
