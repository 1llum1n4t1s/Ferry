  <x:String x:Key="Text.Route.Relay" xml:space="preserve">सेवकरिले (TURN)</x:String>

  <!-- Self-Update Messages (VelopackUpdateDialog.Avalonia 用、Komorebi と同キー命名) -->
  <x:String x:Key="Text.SelfUpdate.Available" xml:space="preserve">अस्य तन्त्रांशस्य नवीनसंस्करणम् उपलभ्यते: </x:String>
  <x:String x:Key="Text.SelfUpdate.Checking" xml:space="preserve">अद्यतनं परीक्ष्यते...</x:String>
  <x:String x:Key="Text.SelfUpdate.DownloadAndInstall" xml:space="preserve">अवतारयतु तथा संस्थापयतु</x:String>
  <x:String x:Key="Text.SelfUpdate.Error" xml:space="preserve">अद्यतनपरीक्षणं विफलम्!</x:String>
  <x:String x:Key="Text.SelfUpdate.IgnoreThisVersion" xml:space="preserve">एतत् संस्करणं लङ्घयतु</x:String>
  <x:String x:Key="Text.SelfUpdate.Title" xml:space="preserve">तन्त्रांशाद्यतनम्</x:String>
  <x:String x:Key="Text.SelfUpdate.UpToDate" xml:space="preserve">सम्प्रति कोऽपि अद्यतनं नोपलभ्यते।</x:String>

  <!-- Transfer Messages -->
  <x:String x:Key="Text.Transfer.Rejected" xml:space="preserve">स्थानान्तरणं निराकृतम्</x:String>
