  <x:String x:Key="Text.Status.Connected" xml:space="preserve">Nakakonekta</x:String>
  <x:String x:Key="Text.Status.Connecting" xml:space="preserve">Kumokonekta...</x:String>
  <x:String x:Key="Text.Status.Reconnecting" xml:space="preserve">Muling kumokonekta...</x:String>

