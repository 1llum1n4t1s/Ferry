  <x:String x:Key="Text.SelfUpdate.UpToDate" xml:space="preserve">Kasalukuyang walang mga update na magagamit.</x:String>

  <!-- Transfer Messages -->
  <x:String x:Key="Text.Transfer.Rejected" xml:space="preserve">Tinanggihan ang paglipat</x:String>
  <x:String x:Key="Text.Transfer.ResumeFailed" xml:space="preserve">Nabigong ipagpatuloy</x:String>
  <x:String x:Key="Text.Transfer.Retrying" xml:space="preserve">Muling sumusubok ({0}/{1})…</x:String>
  <x:String x:Key="Text.Transfer.ConnectFailed" xml:space="preserve">Hindi makakonekta</x:String>
  <x:String x:Key="Text.Transfer.SelectFiles" xml:space="preserve">Select files to transfer</x:String>
  <x:String x:Key="Text.Transfer.SearchPeer" xml:space="preserve">Search peers...</x:String>
