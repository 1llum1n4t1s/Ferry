<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Tabs -->
  <x:String x:Key="Text.Tab.Members" xml:space="preserve">👥 Members</x:String>
  <x:String x:Key="Text.Tab.AddMember" xml:space="preserve">➕ Add Member</x:String>
  <x:String x:Key="Text.Tab.Transfer" xml:space="preserve">📁 Transfer</x:String>
  <x:String x:Key="Text.Tab.Settings" xml:space="preserve">⚙️ Settings</x:String>

  <!-- Sidebar bottom menu (v1.0.38) -->
  <x:String x:Key="Text.Sidebar.AddPeer" xml:space="preserve">Add pairing</x:String>
  <x:String x:Key="Text.Sidebar.Settings" xml:space="preserve">Settings</x:String>
  <x:String x:Key="Text.Sidebar.RefreshPeers" xml:space="preserve">Refresh peers</x:String>
  <x:String x:Key="Text.Connection.PairingCode" xml:space="preserve">Pairing code</x:String>
  <x:String x:Key="Text.Connection.PairFromCode.Header" xml:space="preserve">📋 Paste partner's code to pair</x:String>
  <x:String x:Key="Text.Connection.PairFromCode.Hint" xml:space="preserve">Paste the code shown on the other PC.</x:String>
  <x:String x:Key="Text.Connection.PairFromCode.Button" xml:space="preserve">Pair with this code</x:String>
  <x:String x:Key="Text.Connection.PairFromCode.Placeholder" xml:space="preserve">32-character pairing code</x:String>

  <!-- Drop Overlay -->
  <x:String x:Key="Text.Drop.Message" xml:space="preserve">Drop files to transfer</x:String>
  <x:String x:Key="Text.Drop.Description" xml:space="preserve">Dropped files will be sent to the connected device</x:String>

  <!-- Connection Panel -->
  <x:String x:Key="Text.Connection.Header" xml:space="preserve">Destination</x:String>
  <x:String x:Key="Text.Connection.PairingLink" xml:space="preserve">Or share the pairing link.</x:String>
  <x:String x:Key="Text.Connection.Copy" xml:space="preserve">Copy</x:String>
  <x:String x:Key="Text.Connection.Copied" xml:space="preserve">Copied</x:String>
  <x:String x:Key="Text.Connection.Start" xml:space="preserve">Start Connection</x:String>
  <x:String x:Key="Text.Connection.Cancel" xml:space="preserve">Cancel</x:String>
  <x:String x:Key="Text.Connection.AddDevice" xml:space="preserve">Add New Device</x:String>
  <x:String x:Key="Text.Connection.RemovePeer" xml:space="preserve">Remove Pairing</x:String>
  <x:String x:Key="Text.Connection.Leave" xml:space="preserve">Leave Network</x:String>
  <x:String x:Key="Text.Connection.NoMembers" xml:space="preserve">No paired devices yet</x:String>
  <x:String x:Key="Text.Connection.PairFromUrl.Header" xml:space="preserve">📋 Paste partner's URL to pair</x:String>
  <x:String x:Key="Text.Connection.PairFromUrl.Hint" xml:space="preserve">For camera-less PC pairing. Paste the link shown on the other PC here.</x:String>
  <x:String x:Key="Text.Connection.PairFromUrl.Button" xml:space="preserve">Pair with this URL</x:String>

  <!-- Transfer Panel -->
  <x:String x:Key="Text.Transfer.Header" xml:space="preserve">Transfer History</x:String>
  <x:String x:Key="Text.Transfer.Clear" xml:space="preserve">Clear</x:String>
  <x:String x:Key="Text.Transfer.DropHint" xml:space="preserve">Drop files to transfer</x:String>
  <x:String x:Key="Text.Transfer.Empty" xml:space="preserve">No transfer history</x:String>
  <x:String x:Key="Text.Transfer.Approve" xml:space="preserve">Approve</x:String>
  <x:String x:Key="Text.Transfer.Reject" xml:space="preserve">Reject</x:String>
  <x:String x:Key="Text.Transfer.OpenFolder" xml:space="preserve">Open folder</x:String>

  <!-- Settings Panel -->
  <x:String x:Key="Text.Settings.General" xml:space="preserve">General</x:String>
  <x:String x:Key="Text.Settings.DisplayName" xml:space="preserve">Display Name for Others</x:String>
  <x:String x:Key="Text.Settings.DisplayName.Placeholder" xml:space="preserve">Enter PC name</x:String>
  <x:String x:Key="Text.Settings.Appearance" xml:space="preserve">Appearance</x:String>
  <x:String x:Key="Text.Settings.Theme" xml:space="preserve">Theme</x:String>
  <x:String x:Key="Text.Settings.Theme.System" xml:space="preserve">System (Follow OS)</x:String>
  <x:String x:Key="Text.Settings.Theme.Light" xml:space="preserve">Light</x:String>
  <x:String x:Key="Text.Settings.Theme.Dark" xml:space="preserve">Dark</x:String>
  <x:String x:Key="Text.Settings.Language" xml:space="preserve">Language</x:String>
  <x:String x:Key="Text.Settings.File" xml:space="preserve">File</x:String>
  <x:String x:Key="Text.Settings.SaveDirectory" xml:space="preserve">Received file save location</x:String>
  <x:String x:Key="Text.Settings.SaveDirectory.Browse" xml:space="preserve">Browse</x:String>
  <x:String x:Key="Text.Settings.Behavior" xml:space="preserve">Behavior</x:String>
  <x:String x:Key="Text.Settings.StartMinimized" xml:space="preserve">Start minimized</x:String>
  <x:String x:Key="Text.Settings.StartMinimized.Desc" xml:space="preserve">Launches in the background</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray" xml:space="preserve">Minimize to system tray</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray.Desc" xml:space="preserve">When minimized, hide to system tray instead of taskbar</x:String>
  <x:String x:Key="Text.Settings.Version" xml:space="preserve">Version</x:String>
  <x:String x:Key="Text.Settings.CheckUpdate" xml:space="preserve">Check for Updates</x:String>
  <x:String x:Key="Text.Settings.Version.SkippedVersion" xml:space="preserve">Skipping version {0}</x:String>
  <x:String x:Key="Text.Settings.Version.ClearSkippedVersion" xml:space="preserve">Undo</x:String>

  <!-- Transfer States -->
  <x:String x:Key="Text.State.Pending" xml:space="preserve">Pending...</x:String>
  <x:String x:Key="Text.State.Sending" xml:space="preserve">Sending</x:String>
  <x:String x:Key="Text.State.Receiving" xml:space="preserve">Receiving</x:String>
  <x:String x:Key="Text.State.Completed" xml:space="preserve">Completed</x:String>
  <x:String x:Key="Text.State.Error" xml:space="preserve">Error</x:String>
  <x:String x:Key="Text.State.Cancelled" xml:space="preserve">Cancelled</x:String>
  <x:String x:Key="Text.State.Suspended" xml:space="preserve">Suspended</x:String>
  <x:String x:Key="Text.State.WaitingApproval" xml:space="preserve">Waiting for Approval</x:String>

  <!-- Connection Status -->
  <x:String x:Key="Text.Status.Starting" xml:space="preserve">Starting session...</x:String>
  <x:String x:Key="Text.Status.ScanQR" xml:space="preserve">Scan the QR code with your smartphone</x:String>
  <x:String x:Key="Text.Status.ScanPeerQR" xml:space="preserve">Scan the other PC's QR code...</x:String>
  <x:String x:Key="Text.Status.Error" xml:space="preserve">Error: {0}</x:String>
  <x:String x:Key="Text.Status.Connected" xml:space="preserve">Connected</x:String>
  <x:String x:Key="Text.Status.Connecting" xml:space="preserve">Connecting...</x:String>
  <x:String x:Key="Text.Status.Reconnecting" xml:space="preserve">Reconnecting...</x:String>

  <!-- Connection Routes -->
  <x:String x:Key="Text.Route.Direct" xml:space="preserve">LAN Direct</x:String>
  <x:String x:Key="Text.Route.Stun" xml:space="preserve">Internet P2P (STUN)</x:String>
  <x:String x:Key="Text.Route.Relay" xml:space="preserve">Server Relay (TURN)</x:String>

  <!-- Self-Update Messages (VelopackUpdateDialog.Avalonia 用、Komorebi と同キー命名) -->
  <x:String x:Key="Text.SelfUpdate.Available" xml:space="preserve">New version available!</x:String>
  <x:String x:Key="Text.SelfUpdate.Checking" xml:space="preserve">Checking for updates...</x:String>
  <x:String x:Key="Text.SelfUpdate.DownloadAndInstall" xml:space="preserve">Download &amp; Install</x:String>
  <x:String x:Key="Text.SelfUpdate.Error" xml:space="preserve">Check for updates failed!</x:String>
  <x:String x:Key="Text.SelfUpdate.IgnoreThisVersion" xml:space="preserve">Skip This Version</x:String>
  <x:String x:Key="Text.SelfUpdate.Title" xml:space="preserve">Software Update</x:String>
  <x:String x:Key="Text.SelfUpdate.UpToDate" xml:space="preserve">You're using the latest version.</x:String>
  <x:String x:Key="Text.Close" xml:space="preserve">Close</x:String>

  <!-- Connection Phase Status -->
  <x:String x:Key="Text.Status.Phase.TcpPreparing" xml:space="preserve">Preparing TCP listener...</x:String>
  <x:String x:Key="Text.Status.Phase.TcpConnecting" xml:space="preserve">Trying TCP direct...</x:String>
  <x:String x:Key="Text.Status.Phase.StunQuery" xml:space="preserve">Querying STUN server...</x:String>
  <x:String x:Key="Text.Status.Phase.UdpHolePunch" xml:space="preserve">UDP hole punching...</x:String>
  <x:String x:Key="Text.Status.Phase.Relay" xml:space="preserve">Connecting via relay...</x:String>

  <!-- Tray Menu -->
  <x:String x:Key="Text.Tray.ShowWindow" xml:space="preserve">Show Window</x:String>
  <x:String x:Key="Text.Tray.CheckForUpdate" xml:space="preserve">Check for Updates...</x:String>
  <x:String x:Key="Text.Tray.Exit" xml:space="preserve">Exit</x:String>

  <!-- Transfer Messages -->
  <x:String x:Key="Text.Transfer.Rejected" xml:space="preserve">Transfer rejected</x:String>
  <x:String x:Key="Text.Transfer.ResumeFailed" xml:space="preserve">Resume failed</x:String>
  <x:String x:Key="Text.Transfer.SelectFiles" xml:space="preserve">Select files to transfer</x:String>
  <x:String x:Key="Text.Transfer.SearchPeer" xml:space="preserve">Search peers...</x:String>
  <x:String x:Key="Text.Transfer.SelectMember" xml:space="preserve">Select a member to transfer files</x:String>
  <x:String x:Key="Text.Transfer.SendFile" xml:space="preserve">Send File</x:String>
  <x:String x:Key="Text.Transfer.DropHere" xml:space="preserve">Drop files here to send</x:String>
  <x:String x:Key="Text.Transfer.OrClickSend" xml:space="preserve">or click "Send File" button</x:String>
  <x:String x:Key="Text.Transfer.Accept" xml:space="preserve">Accept</x:String>

  <!-- Pairing -->
  <x:String x:Key="Text.Pairing.LinkLabel" xml:space="preserve">Or share the pairing link</x:String>

  <!-- Settings: Notification -->
  <x:String x:Key="Text.Settings.Notification" xml:space="preserve">Notifications</x:String>
  <x:String x:Key="Text.Settings.NotificationSound" xml:space="preserve">Notification Sound</x:String>
  <x:String x:Key="Text.Settings.NotificationSound.Desc" xml:space="preserve">Play sound when receiving messages</x:String>

  <!-- Settings: File Transfer -->
  <x:String x:Key="Text.Settings.FileTransfer" xml:space="preserve">File Transfer</x:String>
  <x:String x:Key="Text.Settings.ReceiveFileSavePath" xml:space="preserve">Receive File Save Path</x:String>
  <x:String x:Key="Text.Settings.ReceiveFileSavePath.Default" xml:space="preserve">(Downloads folder)</x:String>
  <x:String x:Key="Text.Settings.AutoAcceptFile" xml:space="preserve">Auto Accept Files</x:String>
  <x:String x:Key="Text.Settings.AutoAcceptFile.Desc" xml:space="preserve">Automatically accept incoming files</x:String>

  <!-- Settings: Appearance (extended) -->

  <!-- Settings: Auto Start -->
  <x:String x:Key="Text.Settings.AutoStartWithWindows" xml:space="preserve">Start with Windows</x:String>
  <x:String x:Key="Text.Settings.AutoStartWithWindows.Desc" xml:space="preserve">Register in Windows startup via registry</x:String>

  <!-- Common: 確認ダイアログ等の共通文言 -->
  <x:String x:Key="Text.Warn" xml:space="preserve">Warning</x:String>
  <x:String x:Key="Text.Sure" xml:space="preserve">OK</x:String>
  <x:String x:Key="Text.Cancel" xml:space="preserve">Cancel</x:String>
  <x:String x:Key="Text.Yes" xml:space="preserve">Yes</x:String>
  <x:String x:Key="Text.No" xml:space="preserve">No</x:String>

  <!-- Member: メンバーリスト操作 -->
  <x:String x:Key="Text.Member.Menu" xml:space="preserve">Menu</x:String>
  <x:String x:Key="Text.Member.Delete" xml:space="preserve">Delete</x:String>
  <x:String x:Key="Text.Member.Delete.Confirm" xml:space="preserve">Remove "{0}" from your members?
This cannot be undone.</x:String>

  <!-- v1.0.47: 行ごとの転送操作・受信保存先バー -->
  <x:String x:Key="Text.Transfer.Resend" xml:space="preserve">Resend</x:String>
  <x:String x:Key="Text.Transfer.Pause" xml:space="preserve">Pause</x:String>
  <x:String x:Key="Text.Transfer.Resume" xml:space="preserve">Resume</x:String>
  <x:String x:Key="Text.Transfer.ResumeSuspended" xml:space="preserve">Resume</x:String>
  <x:String x:Key="Text.Transfer.Cancel" xml:space="preserve">Cancel</x:String>
  <x:String x:Key="Text.Transfer.Delete" xml:space="preserve">Delete</x:String>
  <x:String x:Key="Text.Transfer.ClearHistory" xml:space="preserve">Clear history</x:String>
  <x:String x:Key="Text.Transfer.Retrying" xml:space="preserve">Retrying ({0}/{1})…</x:String>
  <x:String x:Key="Text.Transfer.ConnectFailed" xml:space="preserve">Could not establish a connection</x:String>
  <x:String x:Key="Text.Transfer.SourceMissing" xml:space="preserve">Source file not found</x:String>
  <x:String x:Key="Text.Transfer.PeerMissing" xml:space="preserve">Destination peer not found</x:String>
  <x:String x:Key="Text.State.Paused" xml:space="preserve">Paused</x:String>
  <x:String x:Key="Text.SaveBar.Tooltip" xml:space="preserve">Where received files are saved</x:String>
  <x:String x:Key="Text.SaveBar.Open" xml:space="preserve">Open folder</x:String>

</ResourceDictionary>
