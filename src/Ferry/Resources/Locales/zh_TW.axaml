  <x:String x:Key="Text.State.Receiving" xml:space="preserve">接收中</x:String>
  <x:String x:Key="Text.State.Completed" xml:space="preserve">完成</x:String>
  <x:String x:Key="Text.State.Error" xml:space="preserve">錯誤</x:String>
  <x:String x:Key="Text.State.Cancelled" xml:space="preserve">已取消</x:String>
  <x:String x:Key="Text.State.Suspended" xml:space="preserve">已暫停</x:String>
  <x:String x:Key="Text.State.WaitingApproval" xml:space="preserve">等待核准</x:String>
  <x:String x:Key="Text.Status.Starting" xml:space="preserve">正在啟動工作階段…</x:String>
  <x:String x:Key="Text.Status.ScanQR" xml:space="preserve">請用智慧型手機掃描 QR 碼</x:String>
  <x:String x:Key="Text.Status.ScanPeerQR" xml:space="preserve">請掃描另一台電腦的 QR 碼…</x:String>
  <x:String x:Key="Text.Status.Error" xml:space="preserve">錯誤: {0}</x:String>
  <x:String x:Key="Text.Status.Connected" xml:space="preserve">已連線</x:String>
  <x:String x:Key="Text.Status.Connecting" xml:space="preserve">連線中…</x:String>
  <x:String x:Key="Text.Status.Reconnecting" xml:space="preserve">重新連線中…</x:String>
  <x:String x:Key="Text.Route.Direct" xml:space="preserve">區域網路直連</x:String>
  <x:String x:Key="Text.Route.Stun" xml:space="preserve">網際網路 P2P（STUN）</x:String>
  <x:String x:Key="Text.Route.Relay" xml:space="preserve">伺服器中繼（TURN）</x:String>
  <x:String x:Key="Text.Update.Checking" xml:space="preserve">正在檢查更新…</x:String>
  <x:String x:Key="Text.Update.DevEnvironment" xml:space="preserve">開發環境無法檢查更新</x:String>
  <x:String x:Key="Text.Update.Downloading" xml:space="preserve">正在下載 v{0}…</x:String>
  <x:String x:Key="Text.Update.Applying" xml:space="preserve">正在套用更新…即將重新啟動</x:String>
  <x:String x:Key="Text.Update.UpToDate" xml:space="preserve">已是最新版本 ✓</x:String>
  <x:String x:Key="Text.Update.Error" xml:space="preserve">更新檢查失敗: {0}</x:String>
  <x:String x:Key="Text.Update.Unknown" xml:space="preserve">未知</x:String>
  <x:String x:Key="Text.Transfer.Rejected" xml:space="preserve">已拒絕接收</x:String>
  <x:String x:Key="Text.Transfer.ResumeFailed" xml:space="preserve">恢復失敗</x:String>

  <!-- Connection Phase Status -->
  <x:String x:Key="Text.Status.Phase.TcpPreparing" xml:space="preserve">正在準備 TCP 監聽…</x:String>
  <x:String x:Key="Text.Status.Phase.TcpConnecting" xml:space="preserve">正在嘗試 TCP 直連…</x:String>
  <x:String x:Key="Text.Status.Phase.StunQuery" xml:space="preserve">正在查詢 STUN 伺服器…</x:String>
  <x:String x:Key="Text.Status.Phase.UdpHolePunch" xml:space="preserve">UDP 打洞中…</x:String>
  <x:String x:Key="Text.Status.Phase.Relay" xml:space="preserve">正在透過中繼連線…</x:String>

  <!-- Tray Menu -->
  <x:String x:Key="Text.Tray.ShowWindow" xml:space="preserve">顯示視窗</x:String>
  <x:String x:Key="Text.Tray.Exit" xml:space="preserve">結束</x:String>
  <x:String x:Key="Text.Chat.Placeholder">輸入訊息...</x:String>
  <x:String x:Key="Text.Chat.SelectMember">選擇成員以開始聊天</x:String>
  <x:String x:Key="Text.Chat.AttachFile">選擇要傳送的檔案</x:String>

  <!-- Settings: Chat Retention -->
  <x:String x:Key="Text.Settings.ChatRetention" xml:space="preserve">聊天記錄保留</x:String>
  <x:String x:Key="Text.Settings.ChatRetention.Days" xml:space="preserve">天</x:String>
  <x:String x:Key="Text.Settings.ChatRetention.Unlimited" xml:space="preserve">無限制</x:String>

  <x:String x:Key="Text.Pairing.LinkLabel">配對連結</x:String>

  <x:String x:Key="Text.Close" xml:space="preserve">關閉</x:String>

