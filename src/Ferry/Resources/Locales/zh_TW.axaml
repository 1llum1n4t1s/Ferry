  <x:String x:Key="Text.Settings.DisplayName.Placeholder" xml:space="preserve">輸入電腦名稱</x:String>
  <x:String x:Key="Text.Settings.Appearance" xml:space="preserve">外觀</x:String>
  <x:String x:Key="Text.Settings.Theme" xml:space="preserve">主題</x:String>
  <x:String x:Key="Text.Settings.Theme.System" xml:space="preserve">系統（跟隨作業系統）</x:String>
  <x:String x:Key="Text.Settings.Theme.Light" xml:space="preserve">淺色</x:String>
  <x:String x:Key="Text.Settings.Theme.Dark" xml:space="preserve">深色</x:String>
  <x:String x:Key="Text.Settings.Language" xml:space="preserve">語言</x:String>
  <x:String x:Key="Text.Settings.File" xml:space="preserve">檔案</x:String>
  <x:String x:Key="Text.Settings.SaveDirectory" xml:space="preserve">接收檔案儲存位置</x:String>
