  <x:String x:Key="Text.Settings.RunAtStartup" xml:space="preserve">開機時啟動 Ferry</x:String>
  <x:String x:Key="Text.Settings.RunAtStartup.Desc" xml:space="preserve">電腦啟動時自動執行</x:String>
  <x:String x:Key="Text.Settings.StartMinimized" xml:space="preserve">最小化啟動</x:String>
  <x:String x:Key="Text.Settings.StartMinimized.Desc" xml:space="preserve">在背景啟動</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray" xml:space="preserve">關閉時最小化至系統匣</x:String>
  <x:String x:Key="Text.Settings.MinimizeToTray.Desc" xml:space="preserve">關閉按鈕將應用程式傳送至系統匣</x:String>
