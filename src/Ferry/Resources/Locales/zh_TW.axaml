<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Ferry/Resources/Locales/en_US.axaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Tabs -->
  <x:String x:Key="Text.Tab.Members" xml:space="preserve">👥 成員列表</x:String>
  <x:String x:Key="Text.Tab.AddMember" xml:space="preserve">➕ 新增成員</x:String>
