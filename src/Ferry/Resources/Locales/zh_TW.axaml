  <x:String x:Key="Text.Connection.RemovePeer" xml:space="preserve">解除配對</x:String>
  <x:String x:Key="Text.Connection.Leave" xml:space="preserve">離開網路</x:String>
  <x:String x:Key="Text.Transfer.Header" xml:space="preserve">傳輸歷史</x:String>
  <x:String x:Key="Text.Transfer.Clear" xml:space="preserve">清除</x:String>
  <x:String x:Key="Text.Transfer.DropHint" xml:space="preserve">拖放檔案進行傳輸</x:String>
  <x:String x:Key="Text.Transfer.Approve" xml:space="preserve">核准</x:String>
  <x:String x:Key="Text.Transfer.Reject" xml:space="preserve">拒絕</x:String>
