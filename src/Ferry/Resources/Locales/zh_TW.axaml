  <x:String x:Key="Text.Tab.Settings" xml:space="preserve">⚙️ 設定</x:String>
  <x:String x:Key="Text.Drop.Message" xml:space="preserve">拖放檔案進行傳輸</x:String>
  <x:String x:Key="Text.Drop.Description" xml:space="preserve">拖放的檔案將傳送到已連接的裝置</x:String>
