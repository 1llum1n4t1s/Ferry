  <x:String x:Key="Text.Tab.Settings" xml:space="preserve">⚙️ 设置</x:String>
  <x:String x:Key="Text.Drop.Message" xml:space="preserve">拖放文件进行传输</x:String>
  <x:String x:Key="Text.Drop.Description" xml:space="preserve">拖放的文件将发送到已连接的设备</x:String>
