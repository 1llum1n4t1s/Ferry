  <x:String x:Key="Text.Status.Connecting" xml:space="preserve">连接中…</x:String>
  <x:String x:Key="Text.Status.Reconnecting" xml:space="preserve">重新连接中…</x:String>
  <x:String x:Key="Text.Route.Direct" xml:space="preserve">局域网直连</x:String>
  <x:String x:Key="Text.Route.Stun" xml:space="preserve">互联网 P2P（STUN）</x:String>
  <x:String x:Key="Text.Route.Relay" xml:space="preserve">服务器中继（TURN）</x:String>
  <x:String x:Key="Text.Update.Checking" xml:space="preserve">正在检查更新…</x:String>
  <x:String x:Key="Text.Update.DevEnvironment" xml:space="preserve">开发环境无法检查更新</x:String>
  <x:String x:Key="Text.Update.Downloading" xml:space="preserve">正在下载 v{0}…</x:String>
  <x:String x:Key="Text.Update.Applying" xml:space="preserve">正在应用更新…即将重启</x:String>
  <x:String x:Key="Text.Update.UpToDate" xml:space="preserve">已是最新版本 ✓</x:String>
  <x:String x:Key="Text.Update.Error" xml:space="preserve">更新检查失败: {0}</x:String>
