  <x:String x:Key="Text.Status.Starting" xml:space="preserve">正在启动会话…</x:String>
  <x:String x:Key="Text.Status.ScanQR" xml:space="preserve">请用智能手机扫描二维码</x:String>
  <x:String x:Key="Text.Status.ScanPeerQR" xml:space="preserve">请扫描另一台电脑的二维码…</x:String>
