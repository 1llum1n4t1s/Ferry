{
  "rules": {
    ".read": false,
    ".write": false,

    "_comment_v2_2026-06-19": "rere #D-001(a) Phase B 完成。Bridge も Custom Token 化済 (`/pair/token` 経由・signInAnonymously 撤去) で anonymous 攻撃面ゼロ。pairings は per-device path に restructure し atomic multi-path update を許す (書手は auth.uid == $deviceId か、書込データの SidA/SidB のどちらかが auth.uid のときのみ書ける = Bridge ペアリング時に sidA で auth しつつ pairings/{sidB}/{pid} へも書けるが、第三者が他人 pairings に書くのは SidA/SidB に自身が居ないため不可)。CreatedAt の新鮮性 (±60s) でリプレイ防止。pairs/{pairId} と signaling/{pairId} は当事者のみ R/W (32hex_32hex format + beginsWith/endsWith auth.uid)。signaling の per-sender ノード (offers/answers/endpoints) は sender なりすまし防止のため `auth.uid == $senderDeviceId` を必須化。presence に Version フィールド追加 (Step 8 直前 v1.0.62 機械検証用)。設計詳細は docs/design/firebase-auth-pair-ssot.md。",

    "sessions": {
      "$sid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $sid && (!newData.exists() || (newData.child('CreatedAt').val() > now - 60000 && newData.child('CreatedAt').val() < now + 60000))",
        "DisplayName": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "CreatedAt": { ".validate": "newData.isNumber()" },
        "PublicKey": { ".validate": "newData.isString() && newData.val().length <= 256" },
        "$other": { ".validate": false }
      }
    },

    "_comment_pairing_nonces": "Codex P1 fix: PairingNonce はかつて sessions/{sid} に同梱されていたが sessions の .read が `auth != null` (誰でも読める) のため ghost peer 攻撃面となっていた。別ノードに分離し .read: false で server (Workers SA) のみ読める。CreatedAt ±60s ガードで replay 防止。",
    "pairing_nonces": {
      "$sid": {
        ".read": false,
        ".write": "auth != null && auth.uid == $sid && (!newData.exists() || (newData.child('Nonce').val().matches(/^[a-f0-9]{32}$/) && newData.child('CreatedAt').val() > now - 60000 && newData.child('CreatedAt').val() < now + 60000))",
        "Nonce": { ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)" },
        "CreatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "pairings": {
      "$deviceId": {
        ".read": "auth != null && auth.uid == $deviceId",
        "$pid": {
          ".write": "auth != null && auth.uid.length == 32 && (auth.uid == $deviceId || newData.child('SidA').val() == auth.uid || newData.child('SidB').val() == auth.uid) && newData.child('CreatedAt').val() > now - 60000 && newData.child('CreatedAt').val() < now + 60000",
          "SidA": { ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)" },
          "SidB": { ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)" },
          "NameA": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "NameB": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "CreatedAt": { ".validate": "newData.isNumber()" },
          "PkA": { ".validate": "newData.isString() && newData.val().length <= 256" },
          "PkB": { ".validate": "newData.isString() && newData.val().length <= 256" },
          "$other": { ".validate": false }
        }
      }
    },

    "pairs": {
      "$pairId": {
        ".read": "auth != null && auth.uid.length == 32 && $pairId.matches(/^[a-f0-9]{32}_[a-f0-9]{32}$/) && ($pairId.beginsWith(auth.uid + '_') || $pairId.endsWith('_' + auth.uid))",
        ".write": "auth != null && auth.uid.length == 32 && $pairId.matches(/^[a-f0-9]{32}_[a-f0-9]{32}$/) && ($pairId.beginsWith(auth.uid + '_') || $pairId.endsWith('_' + auth.uid))",
        "PairId": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "NameA": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "NameB": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "CreatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "_comment_signaling_no_parent_write": "Codex P1 fix: 親 `signaling/{pairId}.write` を削除した。Firebase は parent .write が子ルールにカスケードし、子で `auth.uid == $senderDeviceId` と狭めても親で許可されていればなりすまし可能。子ごとに必要十分な .write を持たせ、parent には .write を置かない (read は親で当事者制限したまま)。",
    "signaling": {
      "$pairId": {
        ".read": "auth != null && auth.uid.length == 32 && $pairId.matches(/^[a-f0-9]{32}_[a-f0-9]{32}$/) && ($pairId.beginsWith(auth.uid + '_') || $pairId.endsWith('_' + auth.uid))",
        "offers": {
          "$senderDeviceId": {
            ".write": "auth != null && auth.uid == $senderDeviceId && $pairId.matches(/^[a-f0-9]{32}_[a-f0-9]{32}$/) && ($pairId.beginsWith(auth.uid + '_') || $pairId.endsWith('_' + auth.uid))"
          }
        },
        "answers": {
          "$answererDeviceId": {
            ".write": "auth != null && auth.uid == $answererDeviceId && $pairId.matches(/^[a-f0-9]{32}_[a-f0-9]{32}$/) && ($pairId.beginsWith(auth.uid + '_') || $pairId.endsWith('_' + auth.uid))"
          }
        },
        "endpoints": {
          "$senderDeviceId": {
            ".write": "auth != null && auth.uid == $senderDeviceId && $pairId.matches(/^[a-f0-9]{32}_[a-f0-9]{32}$/) && ($pairId.beginsWith(auth.uid + '_') || $pairId.endsWith('_' + auth.uid))"
          }
        },
        "probeOffers": {
          "$nonce": {
            ".write": "auth != null && auth.uid.length == 32 && $pairId.matches(/^[a-f0-9]{32}_[a-f0-9]{32}$/) && ($pairId.beginsWith(auth.uid + '_') || $pairId.endsWith('_' + auth.uid))"
          }
        },
        "probeAnswers": {
          "$nonce": {
            ".write": "auth != null && auth.uid.length == 32 && $pairId.matches(/^[a-f0-9]{32}_[a-f0-9]{32}$/) && ($pairId.beginsWith(auth.uid + '_') || $pairId.endsWith('_' + auth.uid))"
          }
        },
        "createdAt": {
          ".write": "auth != null && auth.uid.length == 32 && $pairId.matches(/^[a-f0-9]{32}_[a-f0-9]{32}$/) && ($pairId.beginsWith(auth.uid + '_') || $pairId.endsWith('_' + auth.uid))"
        }
      }
    },

    "presence": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $deviceId",
        "LastSeen": { ".validate": "newData.isNumber() && newData.val() > now - 60000 && newData.val() < now + 60000" },
        "DisplayName": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "Version": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "$other": { ".validate": false }
      }
    }
  }
}
