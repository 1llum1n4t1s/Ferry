{
  "rules": {
    ".read": false,
    ".write": false,

    "_comment_v2_2026-06-19": "rere #D-001(a) Phase B 完成 + Codex 第3弾 + CodeRabbit 第4弾。Bridge と PC を Custom Token claim `auth.token.src` で区別 (PC=src=='pc', Bridge=src=='bridge')。Bridge は pairings の multi-path update のみ書ける = PC は全 state を書ける。これにより Bridge tab が token expire 前に pairing_nonces/sessions を rotate して session を蘇生する穴を塞ぐ。pairings 緩和ルール (auth.uid == $deviceId || newData.SidA/SidB == auth.uid) は Bridge にも PC にも共通だが、Workers /pair/token が両 nonce を verify してから Bridge token を発行するので「他人 sid を知っているだけで inbox 注入」は不可。CreatedAt ±60s 鮮度・pairs/signaling per-sender 制限は維持。pairings の .write は `!newData.exists()` で delete (newData=null) も許可 (defense-in-depth、Phase B-2 で per-device DELETE 復旧時の前提条件)。設計詳細は docs/design/firebase-auth-pair-ssot.md。",

    "sessions": {
      "$sid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.src == 'pc' && auth.uid == $sid && (!newData.exists() || (newData.child('CreatedAt').val() > now - 60000 && newData.child('CreatedAt').val() < now + 60000))",
        "DisplayName": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "CreatedAt": { ".validate": "newData.isNumber()" },
        "PublicKey": { ".validate": "newData.isString() && newData.val().length <= 256" },
        "$other": { ".validate": false }
      }
    },

    "_comment_pairing_nonces": "Codex P1 fix: PairingNonce はかつて sessions/{sid} に同梱されていたが sessions の .read が `auth != null` (誰でも読める) のため ghost peer 攻撃面となっていた。別ノードに分離し .read: false で server (Workers SA) のみ読める。CreatedAt ±60s ガードで replay 防止。",
    "pairing_nonces": {
      "$sid": {
        ".read": false,
        ".write": "auth != null && auth.token.src == 'pc' && auth.uid == $sid && (!newData.exists() || (newData.child('Nonce').val().matches(/^[a-f0-9]{32}$/) && newData.child('CreatedAt').val() > now - 60000 && newData.child('CreatedAt').val() < now + 60000))",
        "Nonce": { ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)" },
        "CreatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "pairings": {
      "$deviceId": {
        ".read": "auth != null && auth.uid == $deviceId",
        "$pid": {
          ".write": "auth != null && auth.uid.length == 32 && (auth.uid == $deviceId || newData.child('SidA').val() == auth.uid || newData.child('SidB').val() == auth.uid) && (!newData.exists() || (newData.child('CreatedAt').val() > now - 60000 && newData.child('CreatedAt').val() < now + 60000))",
          "SidA": { ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)" },
          "SidB": { ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)" },
          "NameA": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "NameB": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "CreatedAt": { ".validate": "newData.isNumber()" },
          "PkA": { ".validate": "newData.isString() && newData.val().length <= 256" },
          "PkB": { ".validate": "newData.isString() && newData.val().length <= 256" },
          "$other": { ".validate": false }
        }
      }
    },

    "pairs": {
      "$pairId": {
        ".read": "auth != null && auth.token.src == 'pc' && auth.uid.length == 32 && $pairId.matches(/^[a-f0-9]{32}_[a-f0-9]{32}$/) && ($pairId.beginsWith(auth.uid + '_') || $pairId.endsWith('_' + auth.uid))",
        ".write": "auth != null && auth.token.src == 'pc' && auth.uid.length == 32 && $pairId.matches(/^[a-f0-9]{32}_[a-f0-9]{32}$/) && ($pairId.beginsWith(auth.uid + '_') || $pairId.endsWith('_' + auth.uid))",
        "PairId": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "NameA": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "NameB": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "CreatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "_comment_signaling_no_parent_write": "Codex P1 fix: 親 `signaling/{pairId}.write` を削除した。Firebase は parent .write が子ルールにカスケードし、子で `auth.uid == $senderDeviceId` と狭めても親で許可されていればなりすまし可能。子ごとに必要十分な .write を持たせ、parent には .write を置かない (read は親で当事者制限したまま)。",
    "signaling": {
      "$pairId": {
        ".read": "auth != null && auth.uid.length == 32 && $pairId.matches(/^[a-f0-9]{32}_[a-f0-9]{32}$/) && ($pairId.beginsWith(auth.uid + '_') || $pairId.endsWith('_' + auth.uid))",
        "offers": {
          "$senderDeviceId": {
            ".write": "auth != null && auth.token.src == 'pc' && auth.uid == $senderDeviceId && $pairId.matches(/^[a-f0-9]{32}_[a-f0-9]{32}$/) && ($pairId.beginsWith(auth.uid + '_') || $pairId.endsWith('_' + auth.uid))"
          }
        },
        "answers": {
          "$answererDeviceId": {
            ".write": "auth != null && auth.token.src == 'pc' && auth.uid == $answererDeviceId && $pairId.matches(/^[a-f0-9]{32}_[a-f0-9]{32}$/) && ($pairId.beginsWith(auth.uid + '_') || $pairId.endsWith('_' + auth.uid))"
          }
        },
        "endpoints": {
          "$senderDeviceId": {
            ".write": "auth != null && auth.token.src == 'pc' && auth.uid == $senderDeviceId && $pairId.matches(/^[a-f0-9]{32}_[a-f0-9]{32}$/) && ($pairId.beginsWith(auth.uid + '_') || $pairId.endsWith('_' + auth.uid))"
          }
        },
        "probeOffers": {
          "$nonce": {
            ".write": "auth != null && auth.token.src == 'pc' && auth.uid.length == 32 && $pairId.matches(/^[a-f0-9]{32}_[a-f0-9]{32}$/) && ($pairId.beginsWith(auth.uid + '_') || $pairId.endsWith('_' + auth.uid))"
          }
        },
        "probeAnswers": {
          "$nonce": {
            ".write": "auth != null && auth.token.src == 'pc' && auth.uid.length == 32 && $pairId.matches(/^[a-f0-9]{32}_[a-f0-9]{32}$/) && ($pairId.beginsWith(auth.uid + '_') || $pairId.endsWith('_' + auth.uid))"
          }
        },
        "createdAt": {
          ".write": "auth != null && auth.token.src == 'pc' && auth.uid.length == 32 && $pairId.matches(/^[a-f0-9]{32}_[a-f0-9]{32}$/) && ($pairId.beginsWith(auth.uid + '_') || $pairId.endsWith('_' + auth.uid))"
        }
      }
    },

    "presence": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.src == 'pc' && auth.uid == $deviceId",
        "LastSeen": { ".validate": "newData.isNumber() && newData.val() > now - 60000 && newData.val() < now + 60000" },
        "DisplayName": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "Version": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "$other": { ".validate": false }
      }
    }
  }
}
